<% var T = t || {}; var env = Object.keys(T.environment || {}).map(function(k){ return k + '=' + T.environment[k]; }).join('\n'); %>
<div class="tf" data-nest="<%= T.nestId || '' %>" data-egg="<%= T.eggId || '' %>">
  <input type="hidden" name="eggName" class="f-eggname" value="<%= T.eggName || '' %>">
  <div class="grid g2" style="margin-bottom:0">
    <div><label>Bot name</label><input name="name" required maxlength="80" value="<%= T.name || '' %>" placeholder="e.g. Mega WhatsApp Bot"></div>
    <div><label>Bot picture (https link, optional)</label><input name="iconUrl" value="<%= T.iconUrl || '' %>" placeholder="https://…/bot.png"></div>
  </div>
  <label>Description</label><textarea name="description" rows="2" maxlength="600" placeholder="What does this bot do?"><%= T.description || '' %></textarea>

  <label><%= t ? 'Replace ZIP (leave empty to keep the current one)' : 'Bot ZIP file' %></label>
  <input type="file" name="zip" accept=".zip" <%= t ? '' : 'required' %>>
  <% if (t) { %><p class="hint" style="margin:6px 0 0">Current: <%= t.zipName || t.zipFile %> · <%= (t.zipSize/1024/1024).toFixed(2) %> MB · <a href="/admin/templates/<%= t._id %>/zip">download</a></p><% } %>

  <h3 style="margin:20px 0 4px">⚙️ Server (egg + image)</h3>
  <div class="grid g3" style="margin-bottom:0">
    <div><label>Nest</label><select name="nestId" class="f-nest" required><option value="">Loading…</option></select></div>
    <div><label>Egg</label><select name="eggId" class="f-egg" required><option value="">Choose a nest first</option></select></div>
    <div><label>Docker image</label><input name="dockerImage" class="f-img" list="" value="<%= T.dockerImage || '' %>" placeholder="empty = egg default"><datalist class="f-imgs"></datalist></div>
  </div>
  <label>Startup command (optional)</label><input name="startup" value="<%= T.startup || '' %>" placeholder="empty = egg default">
  <label>Egg variables (one per line: KEY=VALUE)</label><textarea name="environment" rows="3" class="f-env" style="font-family:ui-monospace,Menlo,monospace" placeholder="BOT_NAME=Mega&#10;PREFIX=."><%= env %></textarea>
  <div class="chips f-vars" style="margin-top:8px"></div>

  <h3 style="margin:20px 0 4px">📊 Resources</h3>
  <div class="grid g4" style="margin-bottom:0">
    <div><label>RAM (MB)</label><input type="number" name="memory" min="64" required value="<%= T.memory || 512 %>"></div>
    <div><label>Disk (MB)</label><input type="number" name="disk" min="64" required value="<%= T.disk || 1024 %>"></div>
    <div><label>CPU % (0 = unlimited)</label><input type="number" name="cpu" min="0" value="<%= T.cpu || 0 %>"></div>
    <div><label>Databases / Backups</label><div class="row" style="flex-wrap:nowrap"><input type="number" name="databases" min="0" value="<%= T.databases || 0 %>"><input type="number" name="backups" min="0" value="<%= T.backups || 0 %>"></div></div>
  </div>

  <h3 style="margin:20px 0 4px">🪙 Price</h3>
  <div class="grid g3" style="margin-bottom:0">
    <div><label>Price in coins (0 = free)</label><input type="number" name="coins" class="f-coins" min="0" value="<%= t ? (T.coins || 0) : 5000 %>"><p class="hint f-money" data-rate="<%= (typeof coinTZS !== 'undefined' && coinTZS) ? coinTZS : 1 %>" style="margin:4px 0 0"></p></div>
    <div><label>Lasts (days, 0 = never expires)</label><input type="number" name="days" min="0" value="<%= t ? (T.days || 0) : 30 %>"></div>
    <div><label>Visible to customers</label><label class="ob" style="margin:0;padding:12px;display:flex;gap:8px;align-items:center"><input type="checkbox" name="active" <%= (!t || T.active) ? 'checked' : '' %>> Active</label></div>
  </div>

  <h3 style="margin:20px 0 4px">📱 Pair code (WhatsApp bots)</h3>
  <label class="ob" style="display:flex;gap:8px;align-items:center;margin:0 0 6px"><input type="checkbox" name="pairing" <%= (!t || T.pairing) ? 'checked' : '' %>> Ask the customer for a phone number and show the pair code</label>
  <div class="grid g2" style="margin-bottom:0">
    <div><label>Egg variable for the number (optional)</label><input name="phoneVar" value="<%= T.phoneVar || '' %>" placeholder="e.g. PHONE_NUMBER"><p class="hint" style="margin:4px 0 0">Empty = the number is typed into the bot console when it asks.</p></div>
    <div><label>Pair code regex (optional)</label><input name="codeRegex" value="<%= T.codeRegex || '' %>" placeholder="default finds XXXX-XXXX"><p class="hint" style="margin:4px 0 0">Use only if your bot prints the code in a different style. Group 1 = the code.</p></div>
  </div>
</div>
