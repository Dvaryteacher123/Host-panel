if(!reduced&&'IntersectionObserver' in window){
 var sel='.card,.plan,.pc,.flash,.ann,.content>h1,.content>h2,main>h1,main>h2,.row.between.sp';
 var list=[].filter.call(document.querySelectorAll(sel),function(e){return !e.closest('.ov,.modal,dialog,.msgs,.threads,.dv-r');});
 var io=new IntersectionObserver(function(es){es.forEach(function(en){if(en.isIntersecting){en.target.classList.add('dv-in');io.unobserve(en.target);}});},{threshold:.06,rootMargin:'0px 0px -4% 0px'});
 var idx=new Map();
 list.forEach(function(e){var p=e.parentNode,i=idx.get(p)||0;idx.set(p,i+1);e.style.setProperty('--d',Math.min(i,9)*.07+'s');e.classList.add('dv-r');io.observe(e);});
 setTimeout(function(){list.forEach(function(e){e.classList.add('dv-in');});},2600);
}
/* ---- count-up for big numbers (coins, servers ...) ---- */
if(!reduced){[].forEach.call(document.querySelectorAll('.stat b'),function(b){
 var raw=b.textContent.trim();if(!/^\d{1,9}$/.test(raw))return;var n=parseInt(raw,10);if(n<2)return;
 b.textContent='0';var done=false;
 function run(){if(done)return;done=true;var t0=performance.now(),d=1000;(function f(t){var k=Math.min(1,(t-t0)/d),e=1-Math.pow(1-k,3);b.textContent=String(Math.round(n*e));if(k<1)requestAnimationFrame(f);else b.textContent=raw;})(t0);}
 if('IntersectionObserver' in window){var o=new IntersectionObserver(function(es){if(es[0].isIntersecting){run();o.disconnect();}});o.observe(b);}else run();
 setTimeout(function(){if(!done)run();},2800);});}
}catch(err){console.warn('theme',err);}});
</script>
