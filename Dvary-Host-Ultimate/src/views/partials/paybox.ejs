<% var PFX = (typeof pfx !== 'undefined' && pfx) ? pfx : 'pb'; %>
<% if (pay && pay.enabled) { %>
<% if (pay.testMode) { %><div class="flash error" style="margin-top:10px">🧪 TEST MODE — payments are simulated, no real money is charged and no phone prompt is sent.</div><% } %>
<label>Country</label>
<select name="country" id="<%= PFX %>Country"><% pay.countries.forEach(function(c){ %><option value="<%= c.id %>"><%= c.flag %> <%= c.name %> (<%= c.currency %>)</option><% }) %></select>
<label>Payment method</label>
<select name="method" id="<%= PFX %>Method"></select>
<label>Phone number (with country code)</label>
<input name="phone" id="<%= PFX %>Phone" inputmode="tel" maxlength="20" placeholder="255712345678">
<p class="mut" id="<%= PFX %>Price" style="font-weight:700;margin:12px 0 4px"></p>
<p class="mut" style="font-size:12px;margin:0">💳 Cards from banks in other countries work too — pick <b>Tanzania</b> + <b>Card</b> to pay in TZS with any Visa / Mastercard. Mobile money: you get a prompt on your phone.</p>
<script>
(function(){
var PF=<%- JSON.stringify(PFX) %>;var P=<%- JSON.stringify(pay) %>;
var cs=document.getElementById('<%= PFX %>Country'),ms=document.getElementById('<%= PFX %>Method'),ph=document.getElementById('<%= PFX %>Phone'),pr=document.getElementById('<%= PFX %>Price');
function cur(){for(var i=0;i<P.countries.length;i++)if(P.countries[i].id===cs.value)return P.countries[i];return P.countries[0];}
function amt(tzs,fixed){var c=cur();if(c.currency!=='TZS'&&fixed>0)return Math.ceil(fixed);return Math.max(1,Math.ceil(tzs*(P.rates[c.currency]||1)));}
function show(tzs,fixed){return amt(tzs,fixed).toLocaleString('en-US')+' '+cur().currency;}
function methods(){var c=cur(),old=ms.value;ms.innerHTML='';
 if(c.mobile){var o=document.createElement('option');o.value='mobile';o.textContent='📱 Mobile money';ms.appendChild(o);}
 if(c.card){var o2=document.createElement('option');o2.value='card';o2.textContent='💳 Card (Visa / Mastercard)';ms.appendChild(o2);}
 if(old)ms.value=old;if(!ms.value&&ms.options.length)ms.selectedIndex=0;
 if(!ph.value||/^\d{1,4}$/.test(ph.value))ph.placeholder=c.code+'712345678';}
function price(){var qf=window[PF+'Quote'];var q=qf?qf(cur().currency):null;
 pr.textContent=(q&&q.tzs>0)?('Total to pay: '+show(q.tzs,q.fixed)):'';
 var els=PF==='pb'?document.querySelectorAll('.moneyp'):[];for(var i=0;i<els.length;i++){var pp={};try{pp=JSON.parse(els[i].getAttribute('data-prices')||'{}');}catch(e){}els[i].textContent='≈ '+show(Number(els[i].getAttribute('data-tzs')),Number(pp[cur().currency]));}}
cs.addEventListener('change',function(){methods();price();});
document.addEventListener('change',price);document.addEventListener('input',price);
methods();price();
})();
</script>
<% } %>
