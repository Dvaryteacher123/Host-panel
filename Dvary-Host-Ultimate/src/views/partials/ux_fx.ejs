<style>
/* ===== DVARY FX: colours + animations for the Deploy / Templates pages ===== */
.hero,.bc,.term,.steps{animation:dvUp .7s cubic-bezier(.2,.8,.2,1) backwards;animation-delay:var(--d,0s)}
:root{--pink:#f472b6;--lime:#a3e635;--gold:#fbbf24}
@keyframes fxFloat{50%{transform:translateY(-10px) rotate(4deg)}}
@keyframes fxShine{to{background-position:200% center}}
@keyframes fxSpin{to{transform:rotate(360deg)}}
@keyframes fxPulse{0%{box-shadow:0 0 0 0 rgba(124,92,255,.55)}100%{box-shadow:0 0 0 14px rgba(124,92,255,0)}}
@keyframes fxFlip{from{opacity:0;transform:perspective(400px) rotateX(-90deg) scale(.7)}to{opacity:1;transform:none}}
@keyframes fxBlink{50%{opacity:0}}
@keyframes fxSlide{from{opacity:0;transform:translateX(-14px)}to{opacity:1;transform:none}}
@keyframes fxPop{0%{transform:scale(.4);opacity:0}60%{transform:scale(1.18)}100%{transform:scale(1);opacity:1}}
@keyframes fxShimmer{to{background-position:-200% 0}}
@keyframes fxBar{0%{transform:translateX(-100%)}100%{transform:translateX(250%)}}
.hero{position:relative;overflow:hidden;border-radius:26px;padding:30px 28px;margin-bottom:20px;border:1px solid rgba(124,92,255,.4);background:linear-gradient(135deg,rgba(124,92,255,.28),rgba(47,139,255,.16) 55%,rgba(34,211,238,.14))}
.hero:before{content:"";position:absolute;inset:-40%;background:conic-gradient(from 0deg,transparent,rgba(124,92,255,.35),transparent 30%);animation:fxSpin 9s linear infinite;z-index:0}
.hero>*{position:relative;z-index:1}
.hero h1{margin:0 0 6px;font-size:30px}
.hero .fl{position:absolute;right:22px;top:12px;font-size:58px;opacity:.9;animation:fxFloat 4.5s ease-in-out infinite;z-index:1}
.shine{background:linear-gradient(90deg,#c4b5ff,#67e8f9,#f472b6,#c4b5ff);background-size:200% auto;-webkit-background-clip:text;background-clip:text;color:transparent;animation:fxShine 5s linear infinite}
.bgrid{display:grid;gap:18px;grid-template-columns:repeat(auto-fill,minmax(290px,1fr))}
.bc{position:relative;border-radius:24px;padding:3px;background:linear-gradient(135deg,rgba(124,92,255,.5),rgba(34,211,238,.35),rgba(244,114,182,.4));transition:transform .35s cubic-bezier(.2,.8,.2,1),box-shadow .35s}
.bc:hover{transform:translateY(-6px) scale(1.012);box-shadow:0 22px 60px rgba(124,92,255,.35)}
.bc .in{height:100%;border-radius:22px;padding:20px;background:linear-gradient(180deg,#0e1230,#080a1c)}
html[data-theme=light] .bc .in{background:#fff}
.bc .pic{width:100%;height:150px;object-fit:cover;border-radius:16px;margin-bottom:14px;background:linear-gradient(135deg,#7c5cff,#22d3ee);display:grid;place-items:center;font-size:56px;overflow:hidden}
.bc .pic img{width:100%;height:100%;object-fit:cover}
.price{font-size:26px;font-weight:900}.price small{font-size:12px;color:var(--mut);font-weight:600}
.tag{display:inline-block;padding:3px 10px;border-radius:99px;font-size:11px;font-weight:800;letter-spacing:.05em}
.tag.free{background:rgba(163,230,53,.16);color:#bef264}.tag.paid{background:rgba(251,191,36,.16);color:#fcd34d}
.btn.xl{padding:14px 22px;font-size:15px;border-radius:15px;width:100%;text-align:center}
.btn.pink{background:linear-gradient(135deg,#ec4899,#8b5cf6);box-shadow:0 8px 26px rgba(236,72,153,.35)}
.btn.cyan{background:linear-gradient(135deg,#0ea5e9,#22d3ee);box-shadow:0 8px 26px rgba(14,165,233,.35)}
.btn:disabled{opacity:.55;cursor:not-allowed}
/* stepper */
.steps{display:flex;gap:0;margin:6px 0 22px;overflow-x:auto;padding:4px 2px}
.stp{flex:1;min-width:92px;text-align:center;position:relative;font-size:12px;color:var(--mut);font-weight:600}
.stp:before{content:"";position:absolute;top:19px;left:-50%;width:100%;height:3px;background:rgba(255,255,255,.1);z-index:0}
.stp:first-child:before{display:none}
.stp.done:before,.stp.now:before{background:linear-gradient(90deg,#7c5cff,#22d3ee)}
.stp i{position:relative;z-index:1;display:grid;place-items:center;width:40px;height:40px;margin:0 auto 7px;border-radius:50%;font-style:normal;font-size:18px;background:#141836;border:2px solid rgba(255,255,255,.14);transition:.4s}
html[data-theme=light] .stp i{background:#eef0ff}
.stp.done i{background:linear-gradient(135deg,#16a34a,#22c55e);border-color:transparent;color:#fff;animation:fxPop .5s}
.stp.now i{border-color:#7c5cff;animation:fxPulse 1.4s infinite;color:#fff;background:linear-gradient(135deg,#7c5cff,#2f8bff)}
.stp.done,.stp.now{color:var(--tx)}
/* terminal */
.term{background:#03050d;border:1px solid rgba(124,92,255,.35);border-radius:16px;overflow:hidden;box-shadow:0 0 40px rgba(124,92,255,.15)}
.term .tb{display:flex;align-items:center;gap:7px;padding:10px 14px;background:rgba(255,255,255,.04);border-bottom:1px solid var(--line);font-size:12px;color:var(--mut)}
.term .tb b{width:11px;height:11px;border-radius:50%;display:inline-block}
.term .tb b:nth-child(1){background:#ff5f56}.term .tb b:nth-child(2){background:#ffbd2e}.term .tb b:nth-child(3){background:#27c93f}
.term .tb span{margin-left:8px}
.term pre{margin:0;height:340px;overflow:auto;padding:14px;font:12.5px/1.55 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;color:#c9d1ff;white-space:pre-wrap;word-break:break-all}
.term pre div{animation:fxSlide .25s both}
.term pre div.ok{color:#4ade80}.term pre div.er{color:#fb7185}.term pre div.st{color:#67e8f9}
.cur{display:inline-block;width:8px;height:15px;background:#67e8f9;vertical-align:-2px;animation:fxBlink 1s steps(1) infinite}
.prog{height:6px;border-radius:99px;background:rgba(255,255,255,.08);overflow:hidden;margin:12px 0 0}
.prog i{display:block;height:100%;width:40%;border-radius:99px;background:linear-gradient(90deg,#7c5cff,#22d3ee,#f472b6);animation:fxBar 1.6s ease-in-out infinite}
/* pair code */
.codebox{display:flex;gap:7px;justify-content:center;align-items:center;flex-wrap:wrap;margin:16px 0}
.codebox span{width:44px;height:58px;display:grid;place-items:center;border-radius:14px;font-size:28px;font-weight:900;font-family:ui-monospace,Menlo,monospace;background:linear-gradient(160deg,#7c5cff,#2f8bff);color:#fff;box-shadow:0 10px 28px rgba(79,70,229,.45);animation:fxFlip .6s both}
.codebox em{font-style:normal;font-size:26px;color:var(--mut);margin:0 2px}
.codebox span.ph{background:rgba(255,255,255,.07);box-shadow:none;color:var(--mut);animation:none}
.pw{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.pw .badge{font-size:13px;padding:6px 14px}
.led{width:10px;height:10px;border-radius:50%;display:inline-block;margin-right:7px;background:#64748b}
.led.running{background:#22c55e;box-shadow:0 0 12px #22c55e;animation:fxPulse 1.6s infinite}.led.starting{background:#f59e0b;box-shadow:0 0 12px #f59e0b}
.led.offline,.led.stopping{background:#f43f5e}
/* timeline */
.tl{position:relative;margin:0;padding:0 0 0 22px;list-style:none}
.tl:before{content:"";position:absolute;left:6px;top:4px;bottom:4px;width:2px;background:linear-gradient(#7c5cff,#22d3ee,transparent)}
.tl li{position:relative;padding:6px 0 12px;font-size:14px;animation:fxSlide .35s both}
.tl li:before{content:"";position:absolute;left:-21px;top:11px;width:10px;height:10px;border-radius:50%;background:#7c5cff;box-shadow:0 0 0 4px rgba(124,92,255,.25)}
.tl li.start:before,.tl li.paired:before,.tl li.deploy:before{background:#22c55e}.tl li.stop:before,.tl li.failed:before{background:#f43f5e}.tl li.pair:before{background:#f472b6}
.tl small{color:var(--mut);display:block;font-size:11px}
.skel{border-radius:14px;height:18px;background:linear-gradient(90deg,rgba(255,255,255,.05) 25%,rgba(255,255,255,.14) 50%,rgba(255,255,255,.05) 75%);background-size:200% 100%;animation:fxShimmer 1.4s infinite}
.hint{font-size:13px;color:var(--mut)}
.help{counter-reset:h;list-style:none;padding:0;margin:12px 0 0}
.help li{counter-increment:h;position:relative;padding:6px 0 6px 38px;font-size:14px}
.help li:before{content:counter(h);position:absolute;left:0;top:4px;width:26px;height:26px;border-radius:50%;display:grid;place-items:center;font-weight:800;font-size:13px;background:var(--g);color:#fff}
@media(max-width:600px){.hero h1{font-size:23px}.hero .fl{font-size:40px}.codebox span{width:34px;height:48px;font-size:22px}.term pre{height:280px}}
@media(prefers-reduced-motion:reduce){.hero:before,.shine,.stp.now i,.led.running{animation:none!important}}
</style>
