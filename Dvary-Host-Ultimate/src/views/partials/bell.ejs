<style>.bell{position:relative;display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);font-size:18px;color:inherit;text-decoration:none;flex:none}.bell:hover{background:rgba(255,255,255,.12)}.bell .bdg{position:absolute;top:-4px;right:-4px;min-width:19px;height:19px;padding:0 5px;border-radius:99px;background:#f43f5e;color:#fff;font:700 11px/19px Inter,system-ui,sans-serif;font-style:normal;text-align:center;box-shadow:0 0 0 2px #05060f}.bell.ring{animation:ring 2.4s ease-in-out infinite}@keyframes ring{0%,88%,100%{transform:rotate(0)}91%{transform:rotate(14deg)}94%{transform:rotate(-12deg)}97%{transform:rotate(8deg)}}</style><a class="bell <%= unreadNotif > 0 ? 'ring' : '' %>" href="/dashboard/notifications" aria-label="Notifications" title="Notifications">🔔<% if (unreadNotif > 0) { %><i class="bdg"><%= unreadNotif > 99 ? '99+' : unreadNotif %></i><% } %></a>
