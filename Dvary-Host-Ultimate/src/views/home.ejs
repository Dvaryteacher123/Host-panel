<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#05060f">
<title><%= site.siteName %> · Powerful Hosting. Simple Management.</title><style>
:root{--bg:#05060f;--line:rgba(255,255,255,.09);--tx:#eef0ff;--mut:#8b93b8;--a:#7c5cff;--b:#2f8bff;--c:#22d3ee;--ok:#22c55e;--bad:#f43f5e;--warn:#f59e0b;--g:linear-gradient(135deg,#7c5cff,#2f8bff)}
*{box-sizing:border-box}html,body{margin:0}
body{font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--tx);min-height:100vh;-webkit-font-smoothing:antialiased}
body:before{content:"";position:fixed;inset:-10%;z-index:-1;background:radial-gradient(600px 420px at 15% 5%,rgba(124,92,255,.34),transparent 60%),radial-gradient(700px 500px at 95% 10%,rgba(47,139,255,.24),transparent 60%),radial-gradient(600px 500px at 50% 105%,rgba(34,211,238,.12),transparent 60%);animation:drift 18s ease-in-out infinite alternate}
@keyframes drift{to{transform:translate3d(0,-24px,0) scale(1.06)}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
a{color:#a9b4ff;text-decoration:none}
h1{font-size:26px;margin:0 0 18px;letter-spacing:-.02em}h2{font-size:17px;margin:0 0 12px}h3{margin:0}
.grad{background:linear-gradient(135deg,#c4b5ff,#7cb4ff 60%,#67e8f9);-webkit-background-clip:text;background-clip:text;color:transparent}
.card{background:linear-gradient(180deg,rgba(255,255,255,.065),rgba(255,255,255,.025));border:1px solid var(--line);border-radius:20px;padding:20px;box-shadow:0 12px 40px rgba(0,0,0,.35),inset 0 1px 0 rgba(255,255,255,.06);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);transition:transform .25s,border-color .25s,box-shadow .25s}
.card.lift:hover{transform:translateY(-3px);border-color:rgba(124,92,255,.55);box-shadow:0 18px 50px rgba(124,92,255,.2)}
.btn{display:inline-block;border:0;cursor:pointer;padding:11px 18px;border-radius:13px;font-weight:700;font-size:14px;color:#fff;background:var(--g);font-family:inherit;box-shadow:0 8px 24px rgba(79,70,229,.4);transition:transform .15s,filter .15s}
.btn:hover{transform:translateY(-1px);filter:brightness(1.1)}.btn:disabled{opacity:.6;cursor:wait}
.btn.ghost{background:rgba(255,255,255,.04);border:1px solid var(--line);color:var(--tx);box-shadow:none}.btn.ok{background:linear-gradient(135deg,#16a34a,#22c55e);box-shadow:0 8px 24px rgba(34,197,94,.3)}.btn.bad{background:linear-gradient(135deg,#e11d48,#f43f5e);box-shadow:0 8px 24px rgba(244,63,94,.3)}.btn.sm{padding:7px 11px;font-size:12px;border-radius:10px}.btn.lg{padding:15px 28px;font-size:15px}
input,select,textarea{width:100%;padding:12px 13px;border-radius:13px;border:1px solid var(--line);background:rgba(0,0,0,.35);color:var(--tx);font:inherit;outline:0;transition:border-color .2s,box-shadow .2s}
input:focus,select:focus,textarea:focus{border-color:var(--a);box-shadow:0 0 0 3px rgba(124,92,255,.25)}
select option{background:#0d1130}input[type=checkbox],input[type=radio]{width:auto}
label{display:block;font-size:12px;color:var(--mut);margin:13px 0 6px;text-transform:uppercase;letter-spacing:.06em;font-weight:600}
table{width:100%;border-collapse:collapse;font-size:14px}th,td{padding:12px 9px;text-align:left;border-bottom:1px solid var(--line);white-space:nowrap}th{color:var(--mut);font-size:11px;text-transform:uppercase;letter-spacing:.06em}tbody tr:hover td,tr:hover>td{background:rgba(255,255,255,.02)}
.tw{overflow-x:auto;-webkit-overflow-scrolling:touch}
.badge{display:inline-flex;align-items:center;padding:3px 10px;border-radius:99px;font-size:12px;font-weight:700;background:rgba(255,255,255,.1)}
.dot{width:7px;height:7px;border-radius:50%;background:currentColor;display:inline-block;margin-right:6px;box-shadow:0 0 10px currentColor}
.b-ok{background:rgba(34,197,94,.16);color:#4ade80}.b-bad{background:rgba(244,63,94,.16);color:#fb7185}.b-warn{background:rgba(245,158,11,.16);color:#fbbf24}.b-vip{background:var(--g);color:#fff}
.flash{padding:13px 15px;border-radius:14px;margin-bottom:16px;font-size:14px}
.flash.success{background:rgba(34,197,94,.14);border:1px solid rgba(34,197,94,.4)}.flash.error{background:rgba(244,63,94,.14);border:1px solid rgba(244,63,94,.4)}
.ann{padding:12px 15px;border-radius:14px;margin-bottom:16px;font-size:14px;border:1px solid}.ann-info{background:rgba(47,139,255,.12);border-color:rgba(47,139,255,.4)}.ann-success{background:rgba(34,197,94,.12);border-color:rgba(34,197,94,.4)}.ann-warning{background:rgba(245,158,11,.12);border-color:rgba(245,158,11,.45)}
.grid{display:grid;gap:14px;margin-bottom:16px}.g4{grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}.g3{grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}.g2{grid-template-columns:repeat(auto-fit,minmax(310px,1fr))}
.stat small{color:var(--mut);text-transform:uppercase;font-size:11px;letter-spacing:.07em;font-weight:600}.stat b{display:block;font-size:32px;margin-top:4px;letter-spacing:-.02em}
.ic{width:44px;height:44px;border-radius:14px;display:grid;place-items:center;background:var(--g);font-size:21px;margin-bottom:12px;box-shadow:0 8px 20px rgba(79,70,229,.35)}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.between{justify-content:space-between}.mut{color:var(--mut)}.sp{margin-bottom:16px}
.kv{display:grid;grid-template-columns:120px 1fr;gap:9px 12px;font-size:14px}.kv>span:nth-child(odd){color:var(--mut)}
.bar{height:8px;border-radius:99px;background:rgba(255,255,255,.08);overflow:hidden}.bar i{display:block;height:100%;background:var(--g);border-radius:99px}
.chips{display:flex;gap:6px;flex-wrap:wrap}.chip{padding:5px 10px;border-radius:10px;background:rgba(255,255,255,.06);border:1px solid var(--line);font-size:12px;color:#cfd5ff}
.opts{display:grid;gap:10px;grid-template-columns:repeat(auto-fit,minmax(210px,1fr))}.opt{position:relative}.opt input{position:absolute;opacity:0;pointer-events:none}
label.ob{display:block;padding:15px;border:1px solid var(--line);border-radius:16px;cursor:pointer;background:rgba(0,0,0,.25);transition:.2s;font-size:14px;text-transform:none;letter-spacing:0;color:var(--tx);margin:0;font-weight:400}
.opt input:checked+label.ob{border-color:var(--a);box-shadow:0 0 0 2px rgba(124,92,255,.5);background:rgba(124,92,255,.13)}
.opt input:focus-visible+label.ob{outline:2px solid var(--c)}
.foot{text-align:center;color:var(--mut);font-size:13px;padding:26px 14px;border-top:1px solid var(--line);margin-top:30px}.foot a{color:var(--mut);margin:0 8px}

.nav{display:flex;justify-content:space-between;align-items:center;padding:18px 22px;max-width:1180px;margin:0 auto;gap:10px;flex-wrap:wrap}
.logo{font-weight:900;letter-spacing:.1em;font-size:22px;background:linear-gradient(135deg,#c4b5ff,#7cb4ff,#67e8f9);-webkit-background-clip:text;background-clip:text;color:transparent}

html{scroll-behavior:smooth}
.hero{text-align:center;padding:64px 18px 40px;max-width:860px;margin:0 auto}
.hero h1{font-size:clamp(36px,8vw,70px);line-height:1.05;margin:16px 0;letter-spacing:-.03em}.hero p{color:var(--mut);font-size:18px;max-width:560px;margin:0 auto}.hero .row{justify-content:center;margin-top:28px}
.strip{display:flex;justify-content:center;gap:clamp(18px,5vw,56px);flex-wrap:wrap;padding:10px 18px 30px}.strip div{text-align:center}.strip b{display:block;font-size:30px}.strip span{color:var(--mut);font-size:12px;text-transform:uppercase;letter-spacing:.07em}
section{max-width:1180px;margin:0 auto;padding:34px 18px}section>h2{text-align:center;font-size:28px;margin-bottom:6px;letter-spacing:-.02em}section>.lead{text-align:center;color:var(--mut);margin:0 0 24px}
.feat{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:14px}.feat p{margin:6px 0 0;color:var(--mut);font-size:14px}
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:14px;counter-reset:s}.steps .card{counter-increment:s;text-align:center}.steps .card:before{content:counter(s);display:grid;place-items:center;width:40px;height:40px;border-radius:50%;margin:0 auto 10px;font-weight:800;background:var(--g)}
.price{font-size:38px;font-weight:900;margin:12px 0}.price small{font-size:14px;color:var(--mut);font-weight:600}.pl{list-style:none;padding:0;margin:0 0 16px;color:#cfd5ff;font-size:14px}.pl li{padding:5px 0;border-bottom:1px solid var(--line)}
details.card{margin-bottom:10px;padding:16px 20px}summary{cursor:pointer;font-weight:700}details p{color:var(--mut);margin:10px 0 0}
.cta{text-align:center;padding:40px 20px}
.langbtn{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);color:#fff;border-radius:99px;padding:8px 13px;font-weight:700;font-size:12px;cursor:pointer;font-family:inherit}
.rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.8,.2,1)}.rv.in{opacity:1;transform:none}
.mq{overflow:hidden;padding:14px 0 26px;-webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent)}
.mq-track{display:flex;gap:20px;width:max-content;animation:mqL 42s linear infinite}.mq.rev .mq-track{animation-name:mqR;animation-duration:50s}.mq:hover .mq-track{animation-play-state:paused}
@keyframes mqL{to{transform:translateX(-50%)}}@keyframes mqR{from{transform:translateX(-50%)}to{transform:none}}
.big{width:310px;flex:none;padding:28px 26px;border-radius:28px;position:relative;overflow:hidden;background:linear-gradient(160deg,rgba(255,255,255,.1),rgba(255,255,255,.02));border:1px solid rgba(255,255,255,.1);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);box-shadow:0 18px 50px rgba(0,0,0,.4);transition:transform .35s cubic-bezier(.2,.8,.2,1),border-color .3s}
.big:hover{transform:translateY(-10px) rotate(-1.2deg) scale(1.04);border-color:rgba(124,92,255,.7)}
.big:before{content:"";position:absolute;right:-60px;top:-60px;width:220px;height:220px;border-radius:50%;background:radial-gradient(circle,var(--h,rgba(124,92,255,.55)),transparent 65%);filter:blur(8px);animation:glow 4s ease-in-out infinite alternate}
@keyframes glow{to{transform:scale(1.25);opacity:.7}}
.big .ic{font-size:40px;margin-bottom:16px;position:relative;display:inline-block;animation:bob 3.4s ease-in-out infinite}@keyframes bob{50%{transform:translateY(-7px) rotate(-4deg)}}
.big b{display:block;font-size:19px;margin-bottom:7px;position:relative}.big p{margin:0;color:var(--mut);font-size:13.5px;line-height:1.55;position:relative}
.big i{position:absolute;right:20px;bottom:14px;font-style:normal;font-weight:900;font-size:46px;color:rgba(255,255,255,.06)}
.ctw{max-width:880px;margin:0 auto;padding:0 18px 20px}
.ct{position:relative;border-radius:32px;padding:2px;background:linear-gradient(120deg,#7c5cff,#22d3ee,#25d366,#7c5cff);background-size:300% 300%;animation:flow 7s linear infinite}
@keyframes flow{to{background-position:300% 0}}
.ct-in{border-radius:30px;background:rgba(6,8,22,.94);padding:34px 24px;text-align:center}
.ct-in h2{font-size:26px;margin:0 0 6px}.ct-in p{color:var(--mut);margin:0 0 24px}
.cbs{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px}
.cb{display:flex;align-items:center;gap:14px;text-align:left;padding:16px 18px;border-radius:20px;color:#fff;font-weight:700;position:relative;overflow:hidden;transition:transform .25s,box-shadow .25s}
.cb:hover{transform:translateY(-4px) scale(1.02)}.cb .e{font-size:28px;width:48px;height:48px;border-radius:15px;background:rgba(255,255,255,.18);display:grid;place-items:center;flex:none}
.cb small{display:block;font-weight:500;opacity:.85;font-size:12.5px;margin-top:2px}
.cb.wa{background:linear-gradient(135deg,#128c4a,#25d366);box-shadow:0 12px 30px rgba(37,211,102,.3);animation:ring 2.4s infinite}
@keyframes ring{0%{box-shadow:0 0 0 0 rgba(37,211,102,.55)}70%{box-shadow:0 0 0 16px rgba(37,211,102,0)}100%{box-shadow:0 0 0 0 rgba(37,211,102,0)}}
.cb.ph{background:linear-gradient(135deg,#5b3df5,#2f8bff);box-shadow:0 12px 30px rgba(91,61,245,.3)}
.cb.ch{background:linear-gradient(135deg,#0e7490,#22d3ee);box-shadow:0 12px 30px rgba(34,211,238,.25)}
.fab{position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom));z-index:80}
.fab>button{width:58px;height:58px;border-radius:50%;border:0;background:linear-gradient(135deg,#25d366,#128c4a);color:#fff;font-size:26px;cursor:pointer;box-shadow:0 12px 30px rgba(37,211,102,.5);animation:ring 2.4s infinite;transition:transform .25s}
.fab.open>button{transform:rotate(90deg) scale(.92);animation:none}
.fabp{position:absolute;right:0;bottom:70px;width:250px;display:flex;flex-direction:column;gap:10px;opacity:0;pointer-events:none;transform:translateY(14px) scale(.95);transform-origin:bottom right;transition:.28s cubic-bezier(.2,.9,.3,1.2)}
.fab.open .fabp{opacity:1;pointer-events:auto;transform:none}.fabp .cb{padding:12px 14px;font-size:14px}.fabp .cb .e{width:40px;height:40px;font-size:22px}
@media(max-width:600px){.big{width:260px}}
