<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#05060f">
<title>Support Inbox · <%= site.siteName %></title><%- include('../partials/chatcss') %>
<style>
.split{flex:1;display:flex;min-height:0}
.list{width:340px;flex:none;border-right:1px solid var(--line);display:flex;flex-direction:column;background:rgba(6,8,22,.6);min-height:0}
.threads{flex:1;overflow-y:auto}
.th{display:flex;gap:12px;padding:13px 14px;border-bottom:1px solid var(--line);cursor:pointer;align-items:center;transition:background .2s}
.th:hover,.th.on{background:rgba(124,92,255,.14)}
.th .av{width:44px;height:44px;font-size:17px;animation:pop .3s both}.th .m{min-width:0;flex:1}
.th b{display:flex;justify-content:space-between;gap:8px;font-size:14.5px}.th b em{font-style:normal;color:var(--mut);font-size:11px;font-weight:600;flex:none}
.th p{margin:3px 0 0;color:var(--mut);font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.un{background:var(--g);color:#fff;font-size:11px;font-weight:800;min-width:22px;height:22px;border-radius:99px;display:grid;place-items:center;padding:0 6px;flex:none}
.chat{flex:1;display:flex;flex-direction:column;min-width:0;min-height:0}
.chat .hd{padding-top:10px}.chat .bar,.chat .hd{display:none}.chat.sel .bar,.chat.sel .hd{display:flex}
.none{margin:auto;color:var(--mut);text-align:center;font-size:14px}.none span{display:block;font-size:56px;margin-bottom:8px}.chat.sel .none{display:none}
.chat:not(.sel) .msgs{display:none}
.clr{border:1px solid var(--line);background:rgba(244,63,94,.12);color:#fda4af;border-radius:99px;padding:7px 12px;font:inherit;font-size:12px;font-weight:700;cursor:pointer}.clr:hover{background:var(--bad);color:#fff}
.mb{display:none}
@media(max-width:760px){.list{width:100%;border:0}.chat{position:fixed;inset:0;background:var(--bg);transform:translateX(100%);transition:transform .28s;z-index:20}
 .split.open .chat{transform:none}.mb{display:grid}.chat.sel .none{display:none}}
</style></head><body>
<div class="shell"><div class="split" id="split">
<div class="list"><div class="hd"><a class="back" href="/admin" aria-label="Back">‹</a><div class="av">🎧</div><div class="ht"><b>Support Inbox</b><small id="cnt">…</small></div></div><div class="threads" id="threads"></div></div>
<div class="chat" id="chat">
<div class="hd"><button class="back mb" id="bk" type="button" aria-label="Back">‹</button><div class="av" id="cav">?</div><div class="ht"><b id="cnm">—</b><small id="cem"></small></div><button class="clr" id="clr" type="button">🗑 Clear all</button></div>
<div class="none"><span>📥</span>Select a conversation</div>
<div class="msgs" id="msgs"></div>
<form class="bar" id="cf" autocomplete="off"><textarea id="ci" rows="1" maxlength="1000"></textarea><button class="snd" type="submit" aria-label="Send">➤</button></form>
</div></div></div>
<%- include('../partials/chatjs') %>
<script>
(function(){
var csrf=<%- JSON.stringify(csrf) %>,cur=null,names={};
var ch=dvChat({csrf:csrf,url:null,send:null,icon:'🎧',every:2500,empty:{en:'No messages in this conversation.',sw:'Hakuna ujumbe.'},
 map:function(d,api){return d.messages.map(function(m){var mine=m.from==='admin';
  return{id:m.id,key:m.from,mine:mine,name:mine?'':(names[cur]||'User'),text:m.text,at:m.at,
   acts:[{t:api.T.del,fn:function(){if(confirm(api.T.conf))api.post('/admin/support/msg/'+m.id+'/delete',{}).then(api.poll);}}]};});}});
function ago(d){var s=(Date.now()-new Date(d))/1000;if(s<60)return 'now';if(s<3600)return Math.floor(s/60)+'m';if(s<86400)return Math.floor(s/3600)+'h';return Math.floor(s/86400)+'d';}
function open(t){cur=t.uid;names[t.uid]=t.name;document.getElementById('cnm').textContent=t.name;document.getElementById('cem').textContent=t.email;
 document.getElementById('cav').textContent=t.name.charAt(0).toUpperCase();document.getElementById('chat').classList.add('sel');document.getElementById('split').classList.add('open');
 ch.reset('/admin/support/'+t.uid+'/messages','/admin/support/'+t.uid+'/send');loadThreads();}
var lastSig='';
function loadThreads(){fetch('/admin/support/threads',{credentials:'same-origin'}).then(function(r){return r.json();}).then(function(d){
 var sg=JSON.stringify(d.threads)+cur;document.getElementById('cnt').textContent=d.threads.length+' conversations';if(sg===lastSig)return;lastSig=sg;
 var box=document.getElementById('threads');box.innerHTML='';
 if(!d.threads.length){var e=document.createElement('div');e.className='empty';e.style.padding='60px 20px';e.textContent='No support messages yet.';box.appendChild(e);}
 d.threads.forEach(function(t){names[t.uid]=t.name;var r=document.createElement('div');r.className='th'+(t.uid===cur?' on':'');
  var av=document.createElement('div');av.className='av';av.textContent=t.name.charAt(0).toUpperCase();
  var m=document.createElement('div');m.className='m';var b=document.createElement('b');var n=document.createElement('span');n.textContent=t.name;var tm=document.createElement('em');tm.textContent=ago(t.at);b.appendChild(n);b.appendChild(tm);
  var p=document.createElement('p');p.textContent=(t.lastFrom==='admin'?'You: ':'')+t.last;m.appendChild(b);m.appendChild(p);r.appendChild(av);r.appendChild(m);
  if(t.unread){var u=document.createElement('div');u.className='un';u.textContent=t.unread;r.appendChild(u);}
  r.onclick=function(){open(t);};box.appendChild(r);});}).catch(function(){});}
document.getElementById('bk').onclick=function(){document.getElementById('split').classList.remove('open');};
document.getElementById('clr').onclick=function(){if(!cur||!confirm('Delete the whole conversation?'))return;
 var b='_csrf='+encodeURIComponent(csrf);fetch('/admin/support/'+cur+'/clear',{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:b}).then(function(){cur=null;lastSig='';
 document.getElementById('chat').classList.remove('sel');document.getElementById('split').classList.remove('open');ch.reset(null,null);loadThreads();});};
loadThreads();setInterval(loadThreads,4000);
})();
</script></body></html>
