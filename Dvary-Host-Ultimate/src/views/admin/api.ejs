<%- include('../partials/ux_admin_head') %><%- include('../partials/ux_fx') %>
<%- include('../partials/api_tabs') %>
<% if (newKey) { %><div class="card sp" style="border-color:rgba(34,197,94,.6)"><h2>✅ New key for <%= newKeyFor %></h2><p class="hint">Shown only once. The old key already stopped working. Send this key to the customer safely.</p><div class="term"><pre style="height:auto;padding:14px;user-select:all" data-notr><%= newKey %></pre></div></div><% } %>
<div class="grid g3 sp"><div class="card"><small class="mut">SUBSCRIBERS</small><h2 style="margin:4px 0 0"><%= totals.total %></h2></div><div class="card"><small class="mut">ACTIVE NOW</small><h2 style="margin:4px 0 0"><%= totals.active %></h2></div><div class="card"><small class="mut">SUSPENDED</small><h2 style="margin:4px 0 0"><%= totals.suspended %></h2></div></div>

<div class="card sp"><form method="post" action="/admin/api/activate"><input type="hidden" name="_csrf" value="<%= csrf %>">
  <h2>➕ Activate API subscription (manual)</h2>
  <div class="grid g3" style="margin:0"><div><label>User email</label><input name="email" type="email" required placeholder="customer@mail.com"></div><div><label>Days</label><input name="days" type="number" min="1" max="3650" value="<%= plan.durationDays %>"></div><div style="align-self:end"><button class="btn ok">ACTIVATE</button></div></div>
  <p class="hint" style="margin-bottom:0">Normal customers get activated automatically only after their payment is confirmed. Use this for special cases (e.g. cash).</p>
</form></div>

<form method="get" action="/admin/api" class="row sp" style="flex-wrap:nowrap"><input name="q" value="<%= q %>" placeholder="Search name or email" style="flex:1"><select name="st" style="max-width:150px"><option value="">All</option><% ['active','expired','suspended'].forEach(function(x){ %><option value="<%= x %>" <%= st===x?'selected':'' %>><%= x %></option><% }) %></select><button class="btn sm">SEARCH</button></form>

<% if (!subs.length) { %><div class="card mut" style="text-align:center;padding:28px">No subscribers found.</div><% } %>
<% subs.forEach(function(s){ var u = s.user || {}; var state = subSvc.state(s); var k = keyMap[String(s._id)]; var ks = k ? (state==='active' ? 'Active' : (state==='expired' ? 'Expired' : 'Suspended')) : (revSet.has(String(s._id)) ? 'Revoked' : 'Not generated'); var p = payMap[String(u._id)]; var lim = subSvc.limitsFor(plan, s); %>
<div class="card sp">
  <div class="row between">
    <div><b style="font-size:17px"><%= u.name || 'deleted user' %></b> <span class="badge <%= state==='active'?'b-ok':'b-bad' %>"><%= state %></span> <span class="badge <%= ks==='Active'?'b-ok':'b-warn' %>">key: <%= ks %></span><%= u.banned ? ' 🚫 banned' : '' %>
      <div class="mut" style="font-size:13px;margin-top:3px"><%= u.email || '' %></div></div>
    <a class="btn ghost sm" href="/admin/api/logs?sub=<%= s._id %>">📜 Logs</a>
  </div>
  <div class="chips" style="margin-top:10px"><span class="chip">📦 <%= s.planName %> · TSh <%= s.priceTZS.toLocaleString('en-US') %></span><span class="chip">💳 payment: <%= p ? p.status : 'admin / none' %></span><span class="chip">▶ <%= fmtDate(s.startedAt) %></span><span class="chip">⏳ <%= fmtDate(s.expiresAt) %> (<%= subSvc.daysLeft(s) %>d)</span><span class="chip">🖥️ <%= usedMap[String(u._id)] || 0 %>/<%= lim.maxServers %> servers (<%= s.serversCreated %> created)</span><span class="chip">📡 <%= s.totalRequests.toLocaleString('en-US') %> requests</span><span class="chip">🕒 <%= s.lastRequestAt ? fmtDateTime(s.lastRequestAt) + ' UTC' : 'no activity' %></span></div>
  <% if (s.suspended && s.suspendNote) { %><p class="hint" style="margin:8px 0 0">⛔ <%= s.suspendNote %></p><% } %>
  <details style="margin-top:12px"><summary style="cursor:pointer;color:#a9b4ff">Manage</summary>
    <div class="row" style="margin:12px 0">
      <form method="post" action="/admin/api/<%= s._id %>/suspend" class="row" style="flex-wrap:nowrap"><input type="hidden" name="_csrf" value="<%= csrf %>"><% if (!s.suspended) { %><input name="note" maxlength="200" placeholder="Reason (abuse…)" style="min-width:150px"><% } %><button class="btn <%= s.suspended ? 'ok' : 'bad' %> sm"><%= s.suspended ? 'UNSUSPEND' : '⛔ SUSPEND / DISABLE' %></button></form>
      <% if (k) { %><form method="post" action="/admin/api/<%= s._id %>/revoke" onsubmit="return confirm('Revoke this key?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn bad sm">REVOKE KEY</button></form><% } %>
      <% if (state==='active') { %><form method="post" action="/admin/api/<%= s._id %>/regenerate" onsubmit="return confirm('The current key stops working. Generate a new one?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm">🔄 REGENERATE KEY</button></form><% } %>
      <form method="post" action="/admin/api/<%= s._id %>/extend" class="row" style="flex-wrap:nowrap"><input type="hidden" name="_csrf" value="<%= csrf %>"><input name="days" type="number" min="1" max="3650" value="30" style="width:90px"><button class="btn ok sm">+ EXTEND DAYS</button></form>
    </div>
    <form method="post" action="/admin/api/<%= s._id %>/limits"><input type="hidden" name="_csrf" value="<%= csrf %>">
      <h3 style="margin:8px 0">Limits for this customer <span class="hint">(empty = package default)</span></h3>
      <div class="grid g3" style="margin:0">
        <% [['maxServers','Max servers'],['maxRequestsPerDay','Requests / day (0 = unlimited)'],['maxRequestsPerMinute','Requests / minute'],['maxRamMB','Max RAM / server (MB)'],['maxDiskMB','Max disk / server (MB)'],['maxCpu','Max CPU / server (% , 0 = unlimited)']].forEach(function(f){ %><div><label><%= f[1] %></label><input type="number" min="0" name="<%= f[0] %>" value="<%= (s.limitOverrides && s.limitOverrides[f[0]] !== undefined) ? s.limitOverrides[f[0]] : '' %>" placeholder="<%= plan.limits[f[0]] %>"></div><% }) %>
      </div>
      <h3 style="margin:14px 0 6px">Permissions</h3>
      <label class="ob" style="display:flex;gap:8px;align-items:center;margin:0 0 6px"><input type="radio" name="permMode" value="default" <%= Array.isArray(s.permissionsOverride) ? '' : 'checked' %>> Use package permissions</label>
      <label class="ob" style="display:flex;gap:8px;align-items:center;margin:0 0 8px"><input type="radio" name="permMode" value="custom" <%= Array.isArray(s.permissionsOverride) ? 'checked' : '' %>> Custom for this customer:</label>
      <div class="chips"><% Object.keys(PERMS).forEach(function(pm){ var on = Array.isArray(s.permissionsOverride) ? s.permissionsOverride.indexOf(pm) > -1 : plan.permissions.indexOf(pm) > -1; %><label class="chip" style="cursor:pointer"><input type="checkbox" name="perm_<%= pm %>" <%= on ? 'checked' : '' %>> <%= pm %></label><% }) %></div>
      <p style="margin-top:12px"><button class="btn sm">SAVE LIMITS & PERMISSIONS</button></p>
    </form>
  </details>
</div>
<% }) %>
<%- include('../partials/ux_admin_foot') %>
