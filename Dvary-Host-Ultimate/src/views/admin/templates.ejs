<%- include('../partials/ux_admin_head') %><%- include('../partials/ux_fx') %>
<div class="hero dv-r"><div class="fl">🧩</div><h1><span class="shine">Bot Templates</span></h1>
<p class="mut" style="margin:0;max-width:620px">Upload the bot ZIP once and set the egg, Docker image, RAM, CPU and price. Customers only press <b>Deploy</b>: the site installs the ZIP, extracts it and starts the bot for them.</p></div>

<div class="card sp dv-r"><h2>➕ New template</h2>
<form method="post" action="/admin/templates?_csrf=<%= csrf %>" enctype="multipart/form-data" onsubmit="var b=this.querySelector('.sub');b.disabled=true;b.textContent='Uploading…'">
  <%- include('../partials/tplform', { t: null }) %>
  <p style="margin-top:18px"><button class="btn ok xl sub">💾 SAVE TEMPLATE</button></p>
  <p class="hint">Max ZIP size: <%= maxMb %> MB. Put the bot files at the top of the ZIP (or inside one folder).</p>
</form></div>

<h2>All templates (<%= list.length %>)</h2>
<% if (!list.length) { %><div class="card mut">No templates yet.</div><% } %>
<% list.forEach(function(x, i){ %>
<div class="card sp dv-r" style="--d:<%= Math.min(i*0.05,0.4).toFixed(2) %>s">
  <div class="row between">
    <div><b style="font-size:17px"><%= x.name %></b>
      <span class="badge <%= x.active ? 'b-ok' : 'b-bad' %>"><%= x.active ? 'ACTIVE' : 'HIDDEN' %></span>
      <span class="tag <%= x.coins>0 ? 'paid' : 'free' %>"><%= x.coins>0 ? x.coins + ' COINS' : 'FREE' %></span></div>
    <div class="row">
      <form method="post" action="/admin/templates/<%= x._id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn sm <%= x.active ? 'bad' : 'ok' %>"><%= x.active ? 'HIDE' : 'SHOW' %></button></form>
      <form method="post" action="/admin/templates/<%= x._id %>/delete" onsubmit="return confirm('Delete this template and its ZIP? Servers already deployed keep running.')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn bad sm">DELETE</button></form>
    </div>
  </div>
  <div class="chips" style="margin-top:10px"><span class="chip">💾 <%= fmtMB(x.memory) %></span><span class="chip">📀 <%= fmtMB(x.disk) %></span><span class="chip">⚙️ <%= x.cpu ? x.cpu + '%' : 'Unlimited' %></span><span class="chip">🥚 <%= x.eggName || ('Egg #' + x.eggId) %></span><span class="chip">📦 <%= x.zipName || 'bot.zip' %> (<%= (x.zipSize/1024/1024).toFixed(1) %> MB)</span><% if (x.days) { %><span class="chip">⏳ <%= x.days %> days</span><% } %><span class="chip"><%= x.pairing ? '📱 pair code' : '▶ auto start' %></span><span class="chip">🚀 <%= x.deploys %> deploys</span><span class="chip">🟢 <%= liveMap[String(x._id)] || 0 %> running</span></div>
  <details style="margin-top:12px"><summary style="cursor:pointer;color:#a9b4ff">Edit template</summary>
    <form method="post" action="/admin/templates/<%= x._id %>?_csrf=<%= csrf %>" enctype="multipart/form-data" onsubmit="var b=this.querySelector('.sub');b.disabled=true;b.textContent='Saving…'">
      <%- include('../partials/tplform', { t: x }) %>
      <p style="margin-top:16px"><button class="btn lg sub">SAVE CHANGES</button></p>
    </form>
  </details>
</div>
<% }) %>

<script>
(function(){
var cache={nests:null,eggs:{}};
function jget(u){return fetch(u,{credentials:'same-origin'}).then(function(r){return r.json()})}
function nests(){return cache.nests?Promise.resolve(cache.nests):jget('/admin/plans/ptero/nests').then(function(d){cache.nests=d.nests||[];return cache.nests})}
function eggs(n){return cache.eggs[n]?Promise.resolve(cache.eggs[n]):jget('/admin/plans/ptero/nests/'+n+'/eggs').then(function(d){cache.eggs[n]=d.eggs||[];return cache.eggs[n]})}
function opt(v,t,sel){var o=document.createElement('option');o.value=v;o.textContent=t;if(sel)o.selected=true;return o}
document.querySelectorAll('.tf').forEach(function(f,idx){
  var ns=f.querySelector('.f-nest'),es=f.querySelector('.f-egg'),img=f.querySelector('.f-img'),dl=f.querySelector('.f-imgs'),vars=f.querySelector('.f-vars'),env=f.querySelector('.f-env'),en=f.querySelector('.f-eggname');
  var dlId='dl'+idx;dl.id=dlId;img.setAttribute('list',dlId);
  var wantNest=f.dataset.nest,wantEgg=f.dataset.egg;
  function fillEggs(n,pick){
    es.innerHTML='';es.appendChild(opt('','Loading…'));
    eggs(n).then(function(list){
      es.innerHTML='';es.appendChild(opt('','Choose an egg'));
      list.forEach(function(e){es.appendChild(opt(e.id,e.name,String(e.id)===String(pick)))});
      if(pick)showEgg();
    }).catch(function(){es.innerHTML='';es.appendChild(opt('','Could not load eggs'))});
  }
  function showEgg(){
    var n=ns.value,id=es.value;vars.innerHTML='';dl.innerHTML='';
    if(!n||!id||!cache.eggs[n])return;
    var egg=cache.eggs[n].filter(function(e){return String(e.id)===String(id)})[0];if(!egg)return;
    en.value=egg.name;
    egg.images.forEach(function(i){var o=document.createElement('option');o.value=i.image;o.label=i.label;dl.appendChild(o)});
    if(!img.value&&egg.images[0])img.placeholder=egg.images[0].image+' (egg default)';
    egg.vars.forEach(function(v){var c=document.createElement('button');c.type='button';c.className='chip';c.style.cursor='pointer';c.textContent=v.key;c.title=v.name;c.onclick=function(){if(env.value.indexOf(v.key+'=')<0)env.value+=(env.value&&!/\n$/.test(env.value)?'\n':'')+v.key+'=';env.focus()};vars.appendChild(c)});
  }
  nests().then(function(list){
    ns.innerHTML='';ns.appendChild(opt('','Choose a nest'));
    list.forEach(function(n){ns.appendChild(opt(n.id,n.name,String(n.id)===String(wantNest)))});
    if(wantNest)fillEggs(wantNest,wantEgg);
  }).catch(function(){ns.innerHTML='';ns.appendChild(opt('','Panel API not reachable — check Settings'))});
  ns.addEventListener('change',function(){vars.innerHTML='';dl.innerHTML='';fillEggs(ns.value,'')});
  es.addEventListener('change',showEgg);
});
})();
</script>
<%- include('../partials/ux_admin_foot') %>
