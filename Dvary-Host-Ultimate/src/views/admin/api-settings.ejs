<%- include('../partials/ux_admin_head') %><%- include('../partials/ux_fx') %>
<%- include('../partials/api_tabs') %>
<form method="post" action="/admin/api/settings"><input type="hidden" name="_csrf" value="<%= csrf %>">
<div class="card sp"><h2>📦 Package</h2>
  <div class="grid g2" style="margin:0"><div><label>Name</label><input name="name" maxlength="60" value="<%= plan.name %>"></div><div><label>Duration (days)</label><input type="number" name="durationDays" min="1" max="3650" required value="<%= plan.durationDays %>"></div></div>
  <h3 style="margin:16px 0 0">💰 Price per country</h3>
  <%- include('../partials/country_prices', { vals: plan, prefix: 'price_' }) %>
  <label>Features shown to customers (one per line)</label><textarea name="features" rows="5"><%= plan.features.join('\n') %></textarea>
  <label class="ob" style="display:flex;gap:8px;align-items:center;margin-top:10px"><input type="checkbox" name="active" <%= plan.active ? 'checked' : '' %>> Package on sale (turn off to stop new subscriptions and renewals)</label>
</div>
<div class="card sp"><h2>📏 Default limits</h2>
  <div class="grid g3" style="margin:0">
    <div><label>Max servers</label><input type="number" min="0" name="maxServers" value="<%= plan.limits.maxServers %>"></div>
    <div><label>Max requests / day (0 = unlimited)</label><input type="number" min="0" name="maxRequestsPerDay" value="<%= plan.limits.maxRequestsPerDay %>"></div>
    <div><label>Max requests / minute</label><input type="number" min="1" name="maxRequestsPerMinute" value="<%= plan.limits.maxRequestsPerMinute %>"></div>
    <div><label>Max RAM per server (MB)</label><input type="number" min="64" name="maxRamMB" value="<%= plan.limits.maxRamMB %>"></div>
    <div><label>Max disk per server (MB)</label><input type="number" min="64" name="maxDiskMB" value="<%= plan.limits.maxDiskMB %>"></div>
    <div><label>Max CPU per server (%, 0 = unlimited)</label><input type="number" min="0" name="maxCpu" value="<%= plan.limits.maxCpu %>"></div>
  </div>
  <p class="hint" style="margin-bottom:0">These are read from the database on every request. You can also override them for one customer from the Subscribers tab.</p>
</div>
<div class="card sp"><h2>🛡️ API permissions</h2>
  <div class="chips"><% Object.keys(PERMS).forEach(function(pm){ %><label class="chip" style="cursor:pointer"><input type="checkbox" name="perm_<%= pm %>" <%= plan.permissions.indexOf(pm) > -1 ? 'checked' : '' %>> <b><%= pm %></b> — <%= PERMS[pm] %></label><% }) %></div>
  <p class="hint">Turning a permission off applies to every customer without a custom set. <b>servers.delete</b> is off by default.</p>
  <label>Allowed eggs (optional) — one per line as nestId:eggId</label><textarea name="allowedEggs" rows="3" placeholder="empty = the default egg of the panel (.env) and any egg a customer sends"><%= plan.allowedEggs %></textarea>
</div>
<p><button class="btn ok xl">💾 SAVE PACKAGE</button></p></form>
<%- include('../partials/ux_admin_foot') %>
