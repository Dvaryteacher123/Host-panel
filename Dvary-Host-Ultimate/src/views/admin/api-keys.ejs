<%- include('../partials/ux_admin_head') %><%- include('../partials/ux_fx') %>
<div class="hero"><div class="fl">🔑</div><h1><span class="shine">API Apps</span></h1>
<p class="mut" style="margin:0">Apps your customers registered to use the API. You can block any key at once.</p></div>
<% if (!list.length) { %><div class="card mut" style="text-align:center;padding:30px">No API keys yet.</div><% } %>
<% list.forEach(function(k){ %>
<div class="card sp" style="<%= k.revoked ? 'opacity:.55' : '' %>">
  <div class="row between">
    <div><b style="font-size:17px"><%= k.name %></b> <span class="badge <%= k.revoked ? 'b-bad' : 'b-ok' %>"><%= k.revoked ? 'REVOKED' : 'ACTIVE' %></span>
      <div class="mut" style="font-size:13px;margin-top:4px">👤 <%= k.user ? (k.user.name + ' · ' + k.user.email) : 'deleted user' %></div>
      <% if (k.appUrl) { %><div style="font-size:13px;margin-top:3px">🌐 <a href="<%= k.appUrl %>" target="_blank" rel="noopener nofollow"><%= k.appUrl %></a></div><% } %>
      <% if (k.appDescription) { %><div class="mut" style="font-size:13px;margin-top:2px"><%= k.appDescription %></div><% } %>
      <div class="mut" style="font-size:12px;margin-top:4px"><code><%= k.prefix %>••••</code> · <%= k.uses %> requests · created <%= fmtDate(k.createdAt) %> · <%= k.lastUsedAt ? 'last used ' + fmtDateTime(k.lastUsedAt) + ' UTC' : 'never used' %><%= k.lastIp ? ' · ' + k.lastIp : '' %></div></div>
    <% if (!k.revoked) { %><form method="post" action="/admin/api-keys/<%= k._id %>/revoke" onsubmit="return confirm('Block this key now?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn bad sm">BLOCK</button></form><% } %>
  </div>
</div>
<% }) %>
<%- include('../partials/ux_admin_foot') %>
