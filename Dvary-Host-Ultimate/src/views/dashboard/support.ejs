<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#05060f">
<title>Support · <%= site.siteName %></title><%- include('../partials/chatcss') %></head><body>
<div class="shell">
<div class="hd"><a class="back" href="/dashboard" aria-label="Back">‹</a><div class="av">🎧<i></i></div>
<div class="ht"><b data-sw="Msaada · Support">Support</b><small data-sw="Andika tatizo lako, admin atakujibu hapa hapa">Write your problem, an admin will reply right here</small></div></div>
<div class="msgs" id="msgs"></div>
<form class="bar" id="cf" autocomplete="off"><textarea id="ci" rows="1" maxlength="1000"></textarea><button class="snd" type="submit" aria-label="Send">➤</button></form>
</div>
<%- include('../partials/chatjs') %>
<script>
dvChat({csrf:<%- JSON.stringify(csrf) %>,url:'/dashboard/support/messages',send:'/dashboard/support/send',icon:'🎧',every:3000,
 empty:{en:'Hi! Tell us what you need help with. Your message goes straight to the admin.',sw:'Karibu! Tuambie unachohitaji msaada. Ujumbe wako unamfikia admin moja kwa moja.'},
 map:function(d,api){return d.messages.map(function(m){var mine=m.from==='user';
  return{id:m.id,key:m.from,mine:mine,name:mine?'':'Support',badge:mine?'':'TEAM',text:m.text,at:m.at,
   acts:mine?[{t:api.T.del,fn:function(){if(confirm(api.T.conf))api.post('/dashboard/support/'+m.id+'/delete',{}).then(api.poll);}}]:[]};});}});
</script></body></html>
