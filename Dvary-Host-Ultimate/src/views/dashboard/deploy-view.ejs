<%- include('../partials/ux_head') %><%- include('../partials/ux_fx') %>
<a href="/dashboard/deploy" class="mut" style="font-size:14px">← Deploy</a>
<div class="row between sp" style="margin-top:8px"><div><h1 style="margin:0"><span class="shine"><%= server.name %></span></h1><div class="mut" style="font-size:13px"><%= server.templateName %> · <span id="expl"></span></div></div><div class="pw"><span class="badge" id="pst"><i class="led"></i><span id="pstt">…</span></span> <button class="btn ok sm" data-sig="start" type="button">▶ START</button><button class="btn sm" data-sig="restart" type="button">⟳ RESTART</button><button class="btn bad sm" data-sig="stop" type="button">■ STOP</button></div></div>
<div class="steps" id="steps"></div>
<div id="failed" class="card danger sp" style="display:none"><h2>❌ Deploy failed</h2><p id="failmsg" class="mut" style="margin:0"></p><a class="btn" href="/dashboard/deploy">TRY AGAIN</a></div>
<div class="card sp"><div class="row between"><div><h2 style="margin:0">🖥️ Private live console</h2><p class="mut" style="margin:5px 0 0">This console belongs only to <b><%= server.name %></b>. The ZIP decides what it asks for — QR, pair code, phone number, token, menu, or anything else.</p></div><span id="tstat" class="mut">connecting…</span></div><div class="term" style="margin-top:14px"><div class="tb"><b></b><b></b><b></b><span id="tt">Live console</span></div><pre id="term" data-notr></pre></div><div class="prog" id="prog"><i></i></div><div class="row" style="margin-top:10px;flex-wrap:nowrap"><input id="cmd" maxlength="300" placeholder="Type exactly what this bot asks, then press Enter" autocomplete="off"><button class="btn sm" id="cmdgo" type="button">SEND</button></div><p class="hint" style="margin:8px 0 0">Input is sent only to this Pterodactyl server. No shared keyboard or shared console.</p></div>
<div class="card sp"><h2>Details</h2><div class="kv"><span>Status</span><span id="dstat">-</span><span>RAM</span><span><%= fmtMB(server.resources.memory) %></span><span>Disk</span><span><%= fmtMB(server.resources.disk) %></span><span>CPU</span><span><%= server.resources.cpu ? server.resources.cpu + '%' : 'Unlimited' %></span><span>Created</span><span><%= fmtDate(server.createdAt) %></span><% if (server.expiresAt) { %><span>Expires</span><span id="dexp"><%= fmtDate(server.expiresAt) %></span><% } %></div><div class="row" style="margin-top:14px"><a class="btn ghost sm" href="/dashboard/server/<%= server._id %>">⚙️ Server tools</a></div></div>
<div class="card sp"><h2>🕘 History</h2><ul class="tl" id="tl"><li><div class="skel" style="width:60%"></div></li></ul><a href="/dashboard/deploy/history" style="font-size:13px">All deploys →</a></div>
<script>
(function(){var ID=<%- JSON.stringify(String(server._id)) %>,CSRF=<%- JSON.stringify(csrf) %>,CONSOLE=<%- JSON.stringify(!!consoleReady) %>,$=function(i){return document.getElementById(i)},term=$('term'),es=null,lastLog=0,live=false;function put(t){var d=document.createElement('div');d.textContent=t;term.appendChild(d);while(term.childElementCount>900)term.removeChild(term.firstChild);term.scrollTop=term.scrollHeight}function steps(s){var a=[['🧾','Ordered',1],['🖥️','Server',s.status==='active'||/created|installing|uploading/i.test(s.step||'')],['📦','Files',s.status==='active'],['🚀','Running',s.power==='running']];var n=a.findIndex(function(x){return !x[2]});$('steps').innerHTML=a.map(function(x,i){return '<div class="stp '+(x[2]?'done':i===n?'now':'')+'"><i>'+(x[2]?'✓':x[0])+'</i>'+x[1]+'</div>'}).join('')}function power(s){$('pstt').textContent=s.power||s.status;$('dstat').textContent=s.status;document.querySelectorAll('[data-sig]').forEach(function(b){b.disabled=s.status!=='active'})}function events(e){var u=$('tl');u.innerHTML='';(e||[]).slice(0,12).forEach(function(x){var li=document.createElement('li');li.textContent=x.text;var sm=document.createElement('small');sm.textContent=new Date(x.at).toLocaleString();li.appendChild(sm);u.appendChild(li)})}function live(){if(live||!CONSOLE)return;live=true;es=new EventSource('/dashboard/server/'+ID+'/console');es.addEventListener('line',function(e){try{put(JSON.parse(e.data))}catch(x){}});es.addEventListener('ready',function(){$('tstat').textContent='● connected'});es.addEventListener('fatal',function(){try{es.close()}catch(x){}live=false;$('tstat').textContent='reconnecting…';setTimeout(live,5000)})}function poll(){fetch('/dashboard/deploy/'+ID+'/status',{credentials:'same-origin'}).then(function(r){return r.json()}).then(function(s){if(!s.ok)return;if(s.status==='pending'){(s.log||[]).slice(lastLog).forEach(put);lastLog=(s.log||[]).length;$('tstat').textContent=s.step||'working…'}if(s.status==='failed'){$('failed').style.display='';$('failmsg').textContent=s.step||'Deployment failed'}if(s.status==='active'){live();$('prog').style.display='none'}steps(s);power(s);events(s.events);if(s.expiresAt)$('expl').textContent='until '+new Date(s.expiresAt).toISOString().slice(0,10)}).catch(function(){}).finally(function(){setTimeout(poll,2500)})}function send(){var i=$('cmd'),v=i.value.trim();if(!v)return;i.disabled=true;fetch('/dashboard/deploy/'+ID+'/command',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({_csrf:CSRF,command:v}),credentials:'same-origin'}).then(function(r){if(!r.ok)throw 0;i.value=''}).catch(function(){alert('Could not send input to this bot.')}).finally(function(){i.disabled=false;i.focus()})}$('cmdgo').onclick=send;$('cmd').addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();send()}});document.querySelectorAll('[data-sig]').forEach(function(b){b.onclick=function(){fetch('/dashboard/deploy/'+ID+'/power',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({_csrf:CSRF,signal:b.dataset.sig}),credentials:'same-origin'})}});poll()})();</script><%- include('../partials/presence') %></body></html>