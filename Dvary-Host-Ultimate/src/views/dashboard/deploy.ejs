<%- include('../partials/ux_head') %><%- include('../partials/ux_fx') %>
<div class="hero"><div class="fl">🚀</div>
  <h1><span class="shine">Deploy your Bot</span></h1>
  <p class="mut" style="margin:0 0 14px;max-width:560px">Choose a bot, pay with your country's currency, watch it install live, then link your WhatsApp with a pair code. Stop or start it any time.</p>
  <div class="row"><a class="btn ghost sm" href="/dashboard/deploy/history">🕘 Deploy history</a></div>
</div>
<% if (!ready) { %><div class="flash error">Bot hosting is not fully set up yet. The admin must configure the panel API keys.</div><% } %>

<% if (mineList.length) { %>
<h2 class="">My bots</h2>
<div class="grid g3 sp">
<% mineList.forEach(function(m, i){ %>
  <a class="card lift" style="--d:<%= (i*0.06).toFixed(2) %>s;color:inherit" href="/dashboard/deploy/<%= m._id %>">
    <div class="row between"><b><%= m.name %></b>
      <span class="badge <%= m.status==='active'?'b-ok':(m.status==='failed'?'b-bad':'b-warn') %>"><i class="dot"></i><%= m.status==='pending' ? 'installing' : m.status %></span></div>
    <div class="mut" style="font-size:13px;margin-top:6px"><%= m.templateName %><% if (m.phone) { %> · <%= maskPhone(m.phone) %><% } %></div>
    <div class="mut" style="font-size:12px;margin-top:4px"><%= m.pairStatus==='paired' ? '✅ WhatsApp linked' : (m.pairStatus==='code_ready' ? '🔑 Pair code ready' : (m.pairStatus==='need_phone' ? '📱 Needs phone number' : '')) %></div>
  </a>
<% }) %>
</div>
<% } %>

<h2 class="">Available bots</h2>
<% if (!templates.length) { %><div class="card mut" style="text-align:center;padding:34px">No bots yet. Come back soon!</div><% } %>
<div class="bgrid">
<% templates.forEach(function(t, i){ %>
  <div class="bc" style="--d:<%= (i*0.07).toFixed(2) %>s"><div class="in">
    <div class="pic"><% if (t.iconUrl) { %><img src="<%= t.iconUrl %>" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()"><% } else { %>🤖<% } %></div>
    <div class="row between"><h3><%= t.name %></h3><span class="tag paid">PAID</span></div>
    <p class="mut" style="font-size:14px;min-height:42px;margin:8px 0 12px"><%= t.description || 'Ready to deploy in about a minute.' %></p>
    <div class="chips" style="margin-bottom:14px"><span class="chip">💾 <%= fmtMB(t.memory) %></span><span class="chip">📀 <%= fmtMB(t.disk) %></span><span class="chip">⚙️ <%= t.cpu ? t.cpu + '% CPU' : 'Unlimited CPU' %></span><% if (t.days) { %><span class="chip">⏳ <%= t.days %> days</span><% } %><% if (t.pairing) { %><span class="chip">📱 Pair code</span><% } %></div>
    <div class="price">💳 <%= t.priceTZS > 0 ? Number(t.priceTZS).toLocaleString('en-US') + ' TZS' : 'Choose country at checkout' %> <% if (t.days) { %><small>/ <%= t.days %> days</small><% } %></div>
    <% if (t.privateOffer) { %>
      <div class="card" style="margin-top:12px;border-color:rgba(34,197,94,.4);background:rgba(34,197,94,.06)">
        <div class="row between"><b>🪙 PRIVATE COIN OFFER</b><span class="badge b-ok">ONLY YOU</span></div>
        <p class="mut" style="margin:6px 0">Admin gave you this offer. Enter the exact Coins shown below to deploy this bot.</p>
        <form method="post" action="/dashboard/deploy/coin/<%= t._id %>" style="margin-top:10px" onsubmit="var b=this.querySelector('button');b.disabled=true;b.textContent='Deploying with Coins…';return true">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="offerId" value="<%= t.privateOffer._id %>">
          <input name="name" maxlength="60" placeholder="Name your server" required minlength="3" style="margin-bottom:8px">
          <input name="coinAmount" type="number" min="0" step="1" value="<%= t.privateOffer.coins %>" placeholder="Enter Coins" required style="margin-bottom:8px">
          <div class="mut" style="font-size:13px;margin-bottom:9px">🪙 Required: <b><%= Number(t.privateOffer.coins).toLocaleString('en-US') %> Coins</b> · Your balance: <b><%= Number(currentUser.coins || 0).toLocaleString('en-US') %></b></div>
          <button class="btn xl" <%= ready && Number(currentUser.coins || 0) >= Number(t.privateOffer.coins) ? '' : 'disabled' %>>🪙 DEPLOY WITH COINS</button>
        </form>
      </div>
    <% } %>
    <form method="post" action="/dashboard/deploy/new/<%= t._id %>" style="margin-top:12px" onsubmit="var b=this.querySelector('button');b.disabled=true;b.textContent='Opening payment…';return true">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <input name="name" maxlength="60" placeholder="Name your server" required minlength="3" style="margin-bottom:10px">
      <button class="btn xl pink" <%= ready ? '' : 'disabled' %>>💳 CONTINUE TO PAYMENT</button>
    </form>
  </div></div>
<% }) %>
</div>
<%- include('../partials/ux_foot') %>
