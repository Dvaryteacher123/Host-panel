<%- include('../partials/ux_head') %><%- include('../partials/ux_fx') %>
<div class="hero">
  <div class="fl">🚀</div>
  <h1><span class="shine">Deploy your Bot</span></h1>
  <p class="mut" style="margin:0 0 14px;max-width:560px">Choose a bot, pay with mobile money or card, watch it install live, then link your WhatsApp with a pair code. Stop or start it any time.</p>
  <div class="row"><a class="btn ghost sm" href="/dashboard/deploy/history">🕘 Deploy history</a><% if (currentUser.coins > 0) { %><a class="pill" href="/dashboard/store" style="color:inherit">🎁 <%= currentUser.coins %> offer coins</a><% } %></div>
</div>
<% if (!ready) { %><div class="flash error">Bot hosting is not fully set up yet. The admin must configure the panel API keys.</div><% } %>

<div class="card sp" id="coins" style="scroll-margin-top:80px;border-color:rgba(251,191,36,.45);background:linear-gradient(160deg,rgba(251,191,36,.10),rgba(0,0,0,.25))">
  <div class="row between"><div><b style="font-size:17px">🎁 Gift coins</b>
    <% if (currentUser.coins > 0) { %><div style="font-size:14px;margin-top:4px">✅ You already have <b><%= currentUser.coins %></b> coin<%= currentUser.coins === 1 ? '' : 's' %>. No code needed — scroll down to a bot and press <b>USE COIN</b>.</div>
    <% } else { %><div class="mut" style="font-size:13px;margin-top:3px">Got a gift code? Type it below, then press <b>USE COIN</b> on a bot to deploy it free.</div><% } %></div>
  <span class="pill">🪙 <%= currentUser.coins %></span></div>
  <details style="margin-top:12px" <%= currentUser.coins > 0 ? '' : 'open' %>><summary style="cursor:pointer;color:#a9b4ff"><%= currentUser.coins > 0 ? 'I have another gift code' : 'Enter gift code' %></summary>
  <form method="post" action="/dashboard/deploy/gift" class="row" style="flex-wrap:nowrap;margin-top:10px"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <input name="code" maxlength="30" required placeholder="Gift code" autocomplete="off" autocapitalize="characters" style="flex:1;text-transform:uppercase"><button class="btn ok">REDEEM</button></form></details>
</div>

<% if (mineList.length) { %>
<h2>My bots</h2>
<div class="grid g3 sp">
<% mineList.forEach(function(m, i){ %>
  <a class="card lift" style="--d:<%= (i*0.06).toFixed(2) %>s;color:inherit" href="/dashboard/deploy/<%= m._id %>">
    <div class="row between"><b><%= m.name %></b>
      <span class="badge <%= m.status==='active'?'b-ok':(m.status==='failed'?'b-bad':'b-warn') %>"><i class="dot"></i><%= m.status==='pending' ? 'installing' : m.status %></span></div>
    <div class="mut" style="font-size:13px;margin-top:6px"><%= m.templateName %><% if (m.phone) { %> · <%= maskPhone(m.phone) %><% } %></div>
    <div class="mut" style="font-size:12px;margin-top:4px"><%= m.pairStatus==='paired' ? '✅ WhatsApp linked' : (m.pairStatus==='code_ready' ? '🔑 Pair code ready' : (m.pairStatus==='need_phone' ? '📱 Needs phone number' : '')) %></div>
  </a>
<% }) %>
</div>
<% } %>

<h2>Available bots</h2>
<% if (!templates.length) { %><div class="card mut" style="text-align:center;padding:34px">No bots yet. Come back soon!</div><% } %>
<div class="bgrid">
<% templates.forEach(function(t, i){ %>
  <div class="bc" style="--d:<%= (i*0.07).toFixed(2) %>s"><div class="in">
    <div class="pic"><% if (t.iconUrl) { %><img src="<%= t.iconUrl %>" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()"><% } else { %>🤖<% } %></div>
    <div class="row between"><h3><%= t.name %></h3><span class="tag <%= t.free ? 'free' : 'paid' %>"><%= t.free ? 'FREE' : 'PAID' %></span></div>
    <p class="mut" style="font-size:14px;min-height:42px;margin:8px 0 12px"><%= t.description || 'Ready to deploy in about a minute.' %></p>
    <div class="chips" style="margin-bottom:14px"><span class="chip">💾 <%= fmtMB(t.memory) %></span><span class="chip">📀 <%= fmtMB(t.disk) %></span><span class="chip">⚙️ <%= t.cpu ? t.cpu + '% CPU' : 'Unlimited CPU' %></span><% if (t.days) { %><span class="chip">⏳ <%= t.days %> days</span><% } %><% if (t.pairing) { %><span class="chip">📱 Pair code</span><% } %></div>
    <% if (t.free) { %>
      <div class="price">Free</div>
      <form method="post" action="/dashboard/deploy/new/<%= t._id %>" style="margin-top:12px" onsubmit="var b=this.querySelector('button');b.disabled=true;b.textContent='Starting…'">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><input name="name" maxlength="60" placeholder="Name your bot (optional)" style="margin-bottom:10px">
        <button class="btn xl pink" <%= ready ? '' : 'disabled' %>>🚀 DEPLOY FREE</button>
      </form>
    <% } else { %>
      <div class="price"><span class="moneyp" data-tzs="<%= t.priceTZS || 0 %>" data-prices="<%= JSON.stringify(t.prices || {}) %>"></span><% if (t.days) { %> <small>/ <%= t.days %> days</small><% } %></div>
      <button class="btn xl pink paybtn" type="button" style="margin-top:12px" data-id="<%= t._id %>" data-coins="<%= t.offerCoins > 0 ? t.offerCoins : 1 %>" data-name="<%= t.name %>" data-tzs="<%= t.priceTZS || 0 %>" data-prices="<%= JSON.stringify(t.prices || {}) %>" <%= ready ? '' : 'disabled' %>>💳 PAY &amp; DEPLOY</button>
    <% } %>
  </div></div>
<% }) %>
</div>

<div class="card sp" id="payPanel" style="display:none;margin-top:22px;scroll-margin-top:80px">
  <h2>💳 Pay for <span id="pbotName" class="shine"></span></h2>
  <form method="post" id="payForm" action="#"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Bot name (optional)</label><input name="name" maxlength="60" placeholder="e.g. My WhatsApp bot">
    <script>window.curBot=null;window.pbQuote=function(cur){var b=window.curBot;if(!b)return null;var p={};try{p=JSON.parse(b.prices||'{}')}catch(e){}return {tzs:Number(b.tzs),fixed:Number(p[cur])||0};};</script>
    <%- include('../partials/paybox') %>
    <p style="margin-top:14px"><button class="btn xl pink">🚀 PAY NOW &amp; DEPLOY</button></p>
    <p class="hint">Your bot installs automatically as soon as the payment is confirmed.</p>
  </form>
  <div id="coinAlt" style="margin-top:18px;padding-top:16px;border-top:1px dashed var(--line)">
    <b>🎁 Have gift coins? Deploy without paying</b>
    <form method="post" id="coinForm" action="#" style="margin-top:10px"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="via" value="coins"><input type="hidden" name="name" id="coinName">
      <button class="btn xl cyan" id="coinBtn" type="submit">🎁 USE COIN</button></form>
    <p class="hint" id="coinHint" style="margin:8px 0 0"></p>
  </div>
</div>
<script>
(function(){
var panel=document.getElementById('payPanel'),form=document.getElementById('payForm');
document.getElementById('coinForm').addEventListener('submit',function(){document.getElementById('coinName').value=(form.querySelector('[name=name]')||{}).value||'';});
document.querySelectorAll('.paybtn').forEach(function(b){b.addEventListener('click',function(){
  window.curBot={id:b.dataset.id,tzs:b.dataset.tzs,prices:b.dataset.prices};
  form.action='/dashboard/deploy/pay/'+b.dataset.id;document.getElementById('pbotName').textContent=b.dataset.name;
  var need=Number(b.dataset.coins)||1,bal=<%= currentUser.coins %>,cb=document.getElementById('coinBtn');
  document.getElementById('coinForm').action='/dashboard/deploy/new/'+b.dataset.id;
  cb.textContent='🎁 USE '+need+' COIN'+(need>1?'S':'')+' (FREE)';cb.disabled=bal<need;
  document.getElementById('coinHint').textContent=bal>=need?('You have '+bal+' coin'+(bal===1?'':'s')+'. This bot needs '+need+'.'):('You have '+bal+' coin'+(bal===1?'':'s')+' — this bot needs '+need+'. Redeem a gift code above or ask the admin for coins.');
  panel.style.display='';panel.scrollIntoView({behavior:'smooth',block:'start'});
  document.dispatchEvent(new Event('change'));
})});
})();
</script>
<%- include('../partials/ux_foot') %>
