<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#05060f">
<title>Transactions · <%= site.siteName %></title>
<style>
:root{--bg:#05060f;--line:rgba(255,255,255,.09);--tx:#eef0ff;--mut:#8b93b8;--a:#7c5cff;--b:#2f8bff;--c:#22d3ee;--ok:#22c55e;--bad:#f43f5e;--warn:#f59e0b;--g:linear-gradient(135deg,#7c5cff,#2f8bff)}
*{box-sizing:border-box}html,body{margin:0}
body{font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--tx);min-height:100vh;-webkit-font-smoothing:antialiased}
body:before{content:"";position:fixed;inset:-10%;z-index:-1;background:radial-gradient(600px 420px at 15% 5%,rgba(124,92,255,.34),transparent 60%),radial-gradient(700px 500px at 95% 10%,rgba(47,139,255,.24),transparent 60%),radial-gradient(600px 500px at 50% 105%,rgba(34,211,238,.12),transparent 60%);animation:drift 18s ease-in-out infinite alternate}
@keyframes drift{to{transform:translate3d(0,-24px,0) scale(1.06)}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
a{color:#a9b4ff;text-decoration:none}
h1{font-size:26px;margin:0 0 18px;letter-spacing:-.02em}h2{font-size:17px;margin:0 0 12px}h3{margin:0}
.grad{background:linear-gradient(135deg,#c4b5ff,#7cb4ff 60%,#67e8f9);-webkit-background-clip:text;background-clip:text;color:transparent}
.card{background:linear-gradient(180deg,rgba(255,255,255,.065),rgba(255,255,255,.025));border:1px solid var(--line);border-radius:20px;padding:20px;box-shadow:0 12px 40px rgba(0,0,0,.35),inset 0 1px 0 rgba(255,255,255,.06);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);transition:transform .25s,border-color .25s,box-shadow .25s}
.card.lift:hover{transform:translateY(-3px);border-color:rgba(124,92,255,.55);box-shadow:0 18px 50px rgba(124,92,255,.2)}
.btn{display:inline-block;border:0;cursor:pointer;padding:11px 18px;border-radius:13px;font-weight:700;font-size:14px;color:#fff;background:var(--g);font-family:inherit;box-shadow:0 8px 24px rgba(79,70,229,.4);transition:transform .15s,filter .15s}
.btn:hover{transform:translateY(-1px);filter:brightness(1.1)}.btn:disabled{opacity:.6;cursor:wait}
.btn.ghost{background:rgba(255,255,255,.04);border:1px solid var(--line);color:var(--tx);box-shadow:none}.btn.ok{background:linear-gradient(135deg,#16a34a,#22c55e);box-shadow:0 8px 24px rgba(34,197,94,.3)}.btn.bad{background:linear-gradient(135deg,#e11d48,#f43f5e);box-shadow:0 8px 24px rgba(244,63,94,.3)}.btn.sm{padding:7px 11px;font-size:12px;border-radius:10px}.btn.lg{padding:15px 28px;font-size:15px}
input,select,textarea{width:100%;padding:12px 13px;border-radius:13px;border:1px solid var(--line);background:rgba(0,0,0,.35);color:var(--tx);font:inherit;outline:0;transition:border-color .2s,box-shadow .2s}
input:focus,select:focus,textarea:focus{border-color:var(--a);box-shadow:0 0 0 3px rgba(124,92,255,.25)}
select option{background:#0d1130}input[type=checkbox],input[type=radio]{width:auto}
label{display:block;font-size:12px;color:var(--mut);margin:13px 0 6px;text-transform:uppercase;letter-spacing:.06em;font-weight:600}
table{width:100%;border-collapse:collapse;font-size:14px}th,td{padding:12px 9px;text-align:left;border-bottom:1px solid var(--line);white-space:nowrap}th{color:var(--mut);font-size:11px;text-transform:uppercase;letter-spacing:.06em}tbody tr:hover td,tr:hover>td{background:rgba(255,255,255,.02)}
.tw{overflow-x:auto;-webkit-overflow-scrolling:touch}
.badge{display:inline-flex;align-items:center;padding:3px 10px;border-radius:99px;font-size:12px;font-weight:700;background:rgba(255,255,255,.1)}
.dot{width:7px;height:7px;border-radius:50%;background:currentColor;display:inline-block;margin-right:6px;box-shadow:0 0 10px currentColor}
.b-ok{background:rgba(34,197,94,.16);color:#4ade80}.b-bad{background:rgba(244,63,94,.16);color:#fb7185}.b-warn{background:rgba(245,158,11,.16);color:#fbbf24}.b-vip{background:var(--g);color:#fff}
.flash{padding:13px 15px;border-radius:14px;margin-bottom:16px;font-size:14px}
.flash.success{background:rgba(34,197,94,.14);border:1px solid rgba(34,197,94,.4)}.flash.error{background:rgba(244,63,94,.14);border:1px solid rgba(244,63,94,.4)}
.ann{padding:12px 15px;border-radius:14px;margin-bottom:16px;font-size:14px;border:1px solid}.ann-info{background:rgba(47,139,255,.12);border-color:rgba(47,139,255,.4)}.ann-success{background:rgba(34,197,94,.12);border-color:rgba(34,197,94,.4)}.ann-warning{background:rgba(245,158,11,.12);border-color:rgba(245,158,11,.45)}
.grid{display:grid;gap:14px;margin-bottom:16px}.g4{grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}.g3{grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}.g2{grid-template-columns:repeat(auto-fit,minmax(310px,1fr))}
.stat small{color:var(--mut);text-transform:uppercase;font-size:11px;letter-spacing:.07em;font-weight:600}.stat b{display:block;font-size:32px;margin-top:4px;letter-spacing:-.02em}
.ic{width:44px;height:44px;border-radius:14px;display:grid;place-items:center;background:var(--g);font-size:21px;margin-bottom:12px;box-shadow:0 8px 20px rgba(79,70,229,.35)}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.between{justify-content:space-between}.mut{color:var(--mut)}.sp{margin-bottom:16px}
.kv{display:grid;grid-template-columns:120px 1fr;gap:9px 12px;font-size:14px}.kv>span:nth-child(odd){color:var(--mut)}
.bar{height:8px;border-radius:99px;background:rgba(255,255,255,.08);overflow:hidden}.bar i{display:block;height:100%;background:var(--g);border-radius:99px}
.chips{display:flex;gap:6px;flex-wrap:wrap}.chip{padding:5px 10px;border-radius:10px;background:rgba(255,255,255,.06);border:1px solid var(--line);font-size:12px;color:#cfd5ff}
.opts{display:grid;gap:10px;grid-template-columns:repeat(auto-fit,minmax(210px,1fr))}.opt{position:relative}.opt input{position:absolute;opacity:0;pointer-events:none}
label.ob{display:block;padding:15px;border:1px solid var(--line);border-radius:16px;cursor:pointer;background:rgba(0,0,0,.25);transition:.2s;font-size:14px;text-transform:none;letter-spacing:0;color:var(--tx);margin:0;font-weight:400}
.opt input:checked+label.ob{border-color:var(--a);box-shadow:0 0 0 2px rgba(124,92,255,.5);background:rgba(124,92,255,.13)}
.opt input:focus-visible+label.ob{outline:2px solid var(--c)}
.foot{text-align:center;color:var(--mut);font-size:13px;padding:26px 14px;border-top:1px solid var(--line);margin-top:30px}.foot a{color:var(--mut);margin:0 8px}

.app{display:flex;min-height:100vh}
.side{width:256px;flex:none;padding:20px 14px;background:rgba(6,8,22,.78);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border-right:1px solid var(--line);display:flex;flex-direction:column;gap:4px;position:sticky;top:0;height:100vh;overflow-y:auto}
.brand{font-weight:900;font-size:20px;letter-spacing:.09em;padding:6px 10px 18px;background:linear-gradient(135deg,#c4b5ff,#7cb4ff,#67e8f9);-webkit-background-clip:text;background-clip:text;color:transparent}
.brand small{font-size:10px;letter-spacing:.1em;-webkit-text-fill-color:#fbbf24;margin-left:4px}
.side a.nv{padding:11px 13px;border-radius:13px;color:var(--mut);font-weight:600;display:block;transition:.15s}
.side a.nv:hover{background:rgba(255,255,255,.05);color:#fff}.side a.nv.on{background:linear-gradient(135deg,rgba(124,92,255,.28),rgba(47,139,255,.18));color:#fff;box-shadow:inset 0 0 0 1px rgba(124,92,255,.4)}
.side .bot{margin-top:auto;padding-top:14px}
.main{flex:1;min-width:0;display:flex;flex-direction:column}
.top{display:flex;align-items:center;gap:12px;justify-content:flex-end;padding:14px 24px;border-bottom:1px solid var(--line);background:rgba(5,6,15,.5);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);position:sticky;top:0;z-index:30}
.burger{display:none;margin-right:auto;background:rgba(255,255,255,.05);border:1px solid var(--line);color:#fff;border-radius:11px;padding:8px 13px;font-size:18px;cursor:pointer}
.pill{padding:8px 14px;border-radius:99px;background:rgba(124,92,255,.18);border:1px solid rgba(124,92,255,.5);font-weight:700;font-size:14px}
.who{display:flex;align-items:center;gap:9px;font-size:14px}.av{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;font-weight:800;background:var(--g)}
.content{padding:24px;width:100%;max-width:1250px;flex:1}
.ov{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:45}.side.open+.ov{display:block}
.bnav{display:none}
@media(max-width:860px){
.side{position:fixed;left:-280px;z-index:50;transition:left .25s;height:100%;width:256px}.side.open{left:0}.burger{display:block}
.content{padding:16px 14px 100px}.top{padding:11px 14px}.who span.nm{display:none}.kv{grid-template-columns:100px 1fr}h1{font-size:22px}
.bnav{display:flex;position:fixed;bottom:0;left:0;right:0;z-index:40;background:rgba(7,9,24,.92);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-top:1px solid var(--line);padding:6px 6px calc(6px + env(safe-area-inset-bottom))}
.bnav a{flex:1;text-align:center;font-size:11px;font-weight:600;color:var(--mut);padding:6px 2px;border-radius:13px}.bnav a span{display:block;font-size:20px;line-height:1.2}.bnav a.on{color:#fff;background:rgba(124,92,255,.22)}
.foot{padding-bottom:90px}}
</style></head><body>
<div class="app">
<aside class="side" id="side"><div class="brand"><%= site.siteName %></div><a class="nv <%= active==='home'?'on':'' %>" href="/dashboard">🏠 Dashboard</a><a class="nv <%= active==='store'?'on':'' %>" href="/dashboard/store">🚀 Deploy / Store</a><a class="nv <%= active==='servers'?'on':'' %>" href="/dashboard/servers">🖥️ My Servers</a><a class="nv <%= active==='coins'?'on':'' %>" href="/dashboard/coins">🪙 Coins</a><a class="nv <%= active==='transactions'?'on':'' %>" href="/dashboard/transactions">🧾 Transactions</a><a class="nv <%= active==='profile'?'on':'' %>" href="/dashboard/profile">👤 Profile</a><% if (currentUser.role==='admin') { %><a class="nv" href="/admin">🛡️ Admin Panel</a><% } %>
<div class="bot"><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn ghost" style="width:100%">Logout</button></form></div></aside>
<div class="ov" id="ov" onclick="document.getElementById('side').classList.remove('open')"></div>
<div class="main"><header class="top"><button class="burger" type="button" onclick="document.getElementById('side').classList.toggle('open')" aria-label="Menu">☰</button>
<div class="pill">🪙 <%= currentUser.coins %> Coins</div>
<div class="who"><div class="av"><%= currentUser.name.charAt(0).toUpperCase() %></div><span class="nm"><%= currentUser.name %></span></div></header>
<main class="content"><% if (site.announcement && site.announcement.active && site.announcement.text) { %><div class="ann ann-<%= site.announcement.type %>">📢 <%= site.announcement.text %></div><% } %><% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.msg %></div><% } %><h1>🧾 Transactions</h1>
<% if (!transactions.length) { %><div class="card mut">No transactions yet.</div><% } else { %><div class="card tw"><table><tr><th>Date</th><th>Type</th><th>Amount</th><th>Balance After</th><th>Description</th><th>Reference</th></tr><% transactions.forEach(function(t){ %><tr><td><%= fmtDate(t.createdAt) %></td><td><span class="badge <%= t.type==='debit'?'b-bad':'b-ok' %>"><%= t.type %></span></td><td><b style="color:<%= t.type==='debit'?'#fb7185':'#4ade80' %>"><%= t.type==='debit'?'-':'+' %><%= t.amount %></b></td><td><%= t.balanceAfter %></td><td><%= t.description %><% if (t.meta && t.meta.reason) { %> <span class="mut">(<%= t.meta.reason %>)</span><% } %></td><td class="mut"><%= t.reference %></td></tr><% }) %></table></div><% } %></main><footer class="foot">© 2026 <%= site.siteName %> · <a href="/">Home</a><% if (site.supportLink) { %><a target="_blank" rel="noopener" href="<%= site.supportLink %>">Support</a><% } %><a href="/dashboard/store">Plans</a></footer></div></div>
<nav class="bnav"><a class="<%= active==='home'?'on':'' %>" href="/dashboard"><span>🏠</span>Home</a><a class="<%= active==='store'?'on':'' %>" href="/dashboard/store"><span>🚀</span>Deploy</a><a class="<%= active==='servers'?'on':'' %>" href="/dashboard/servers"><span>🖥️</span>My Servers</a><a class="<%= active==='coins'?'on':'' %>" href="/dashboard/coins"><span>🪙</span>Coins</a><a class="<%= active==='profile'?'on':'' %>" href="/dashboard/profile"><span>👤</span>Profile</a></nav></body></html>
