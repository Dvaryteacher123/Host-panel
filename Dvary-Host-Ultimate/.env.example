PORT=3000

MONGODB_URI=mongodb://127.0.0.1:27017/dvary_host

SESSION_SECRET=CHANGE_THIS

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS

PTERODACTYL_URL=https://panel.example.com
PTERODACTYL_API_KEY=ptla_CHANGE_ME

PTERODACTYL_NEST_ID=1
PTERODACTYL_EGG_ID=1
PTERODACTYL_LOCATION_ID=1

# Optional (leave empty to use the egg defaults from the panel)
PTERODACTYL_DOCKER_IMAGE=
PTERODACTYL_STARTUP=
# Optional: use one fixed allocation ID instead of automatic deployment
PTERODACTYL_ALLOCATION_ID=

# Set to true when the site is served over HTTPS
COOKIE_SECURE=false

# Live console + power buttons (Client API key of a ROOT ADMIN account: panel > Account > API Credentials, starts with ptlc_)
PTERODACTYL_CLIENT_API_KEY=

# 32 random bytes encoded as 64 hex characters. Keep this secret permanently.

# Private admin chat: seconds without a heartbeat before an admin shows as Offline (default 60)
ADMIN_ONLINE_SECONDS=60


# Sign in with Google (optional). Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be exactly: https://YOUR-DOMAIN/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: force the callback URL (recommended behind a proxy), e.g. https://dvarytech.online/auth/google/callback
GOOGLE_CALLBACK_URL=


# =====================================================================
# AUTOMATIC PAYMENTS - FimiPay (https://docs.fimipay.com)
# Customers pay with mobile money or card and get their server / coins automatically.
# The manual "Request coins" system keeps working exactly as before.
# =====================================================================

# Public address of your website (NO trailing slash). Used for the card/checkout return page.
APP_URL=https://dvarytech.online

# FimiPay dashboard -> API keys. Start with the TEST key (sk_test_...) to try it with no real money,
# then switch to the LIVE key (sk_live_...). NEVER put the secret key in the browser or in Git.
FIMIPAY_SECRET_KEY=sk_test_CHANGE_ME
FIMIPAY_BASE_URL=https://fimipay.com/api/v1

# FimiPay dashboard -> Webhooks -> Live (V4):
#   URL    = https://dvarytech.online/webhook/fimipay
#   Secret = click "Generate secret", copy it here, then press Save in FimiPay.
FIMIPAY_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# Test keys only: force the result of every test payment: success | pending | failed (leave empty for default)
FIMIPAY_TEST_OUTCOME=success

# Fallback price of 1 coin in TZS. The admin can change it later in Admin -> Settings,
# and set a fixed money price per plan in Admin -> Plans (that one wins).
COIN_PRICE_TZS=100

# Countries shown at checkout (from the FimiPay docs): TZ,KE,UG,NG,GH,CM,ZA
# Tanzania + Card also accepts international Visa / Mastercard (cards from banks of other countries).
FIMIPAY_COUNTRIES=TZ,KE,UG,NG,GH,CM,ZA

# Conversion from TZS to the other currencies: how many units of that currency equal 1 TZS.
# Only ROUGH defaults - the admin can override them in Admin -> Settings (no restart needed).
FIMIPAY_RATES=KES:0.05,UGX:1.4,NGN:0.6,GHS:0.0045,XAF:0.23,ZAR:0.007


# =====================================================================
# TELEGRAM SHOP BOT (optional)
# Customers press /start in your bot, pick a service (server, admin panel, ZIP) and pay automatically (FimiPay).
# 1) Telegram -> @BotFather -> /newbot -> copy the token here.
# 2) APP_URL above MUST be your public https:// address. The webhook https://YOUR-DOMAIN/webhook/telegram
#    is registered by itself every time the site starts (check the log for "[tg] bot @... is ready").
# =====================================================================
TELEGRAM_BOT_TOKEN=
# Optional: a secret word Telegram sends with every update (letters, numbers, _ and - only). Empty = derived from the token.
TELEGRAM_WEBHOOK_SECRET=
