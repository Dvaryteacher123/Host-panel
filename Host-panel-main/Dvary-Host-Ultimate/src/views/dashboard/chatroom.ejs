<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#05060f">
<title>Chat · <%= peer.name %> · <%= site.siteName %></title><%- include('../partials/chatcss') %>
<style>.av i.off{background:#f43f5e;animation:none}.ht small.on{color:#4ade80}.ht small.off{color:#fb7185}</style><%- include('../partials/theme') %></head><body>
<div class="shell">
<div class="hd"><a class="back" href="/dashboard/chat" aria-label="Back">‹</a><div class="av"><%= peer.name.charAt(0).toUpperCase() %><i id="dot" class="<%= peer.online ? '' : 'off' %>"></i></div>
<div class="ht"><b id="pn"><%= peer.name %></b><small id="ps" class="<%= peer.online ? 'on' : 'off' %>"><%= peer.online ? '🟢 Online' : '🔴 Offline' %></small></div></div>
<div class="msgs" id="msgs"></div>
<form class="bar" id="cf" autocomplete="off"><textarea id="ci" rows="1" maxlength="1000"></textarea><button class="snd" type="submit" aria-label="Send">➤</button></form>
</div>
<%- include('../partials/chatjs') %>
<script>
(function(){
var cid=<%- JSON.stringify(conv.id) %>;
var sw=false;try{sw=localStorage.getItem('dvary_lang')==='sw';}catch(e){}
function status(p){if(!p)return;var on=!!p.online;document.getElementById('dot').className=on?'':'off';var s=document.getElementById('ps');s.className=on?'on':'off';s.textContent=on?'🟢 Online':'🔴 Offline';}
dvChat({csrf:<%- JSON.stringify(csrf) %>,url:'/dashboard/chat/c/'+cid+'/messages',send:'/dashboard/chat/c/'+cid+'/send',live:'/dashboard/chat/stream',icon:'💬',every:15000,
 empty:{en:'Say hello 👋 This is a private chat between you and this admin.',sw:'Salimia 👋 Hii ni chat ya siri kati yako na admin huyu.'},
 map:function(d){status(d.peer);return d.messages.map(function(m){var mine=m.from==='user';
  return{id:m.id+(m.read?'r':''),key:m.from,mine:mine,name:mine?'':document.getElementById('pn').textContent,badge:mine?'':'ADMIN',text:m.text,at:m.at,tick:mine?(m.read?' ✓✓':' ✓'):'',acts:[]};});}});
setInterval(function(){/* keeps the Online/Offline dot fresh even when nobody writes */},60000);
})();
</script></body></html>
