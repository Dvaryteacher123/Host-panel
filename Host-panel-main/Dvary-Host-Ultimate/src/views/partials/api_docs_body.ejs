.dc pre.code{background:#03050d;border:1px solid rgba(124,92,255,.3);border-radius:14px;padding:14px;overflow:auto;font:12.5px/1.55 ui-monospace,Menlo,Consolas,monospace;color:#c9d1ff;margin:10px 0;white-space:pre}
.dc code{font-family:ui-monospace,Menlo,Consolas,monospace;background:rgba(124,92,255,.15);padding:1px 6px;border-radius:6px;font-size:.92em}.dc pre.code code{background:none;padding:0}
.m{display:inline-block;min-width:60px;text-align:center;padding:3px 9px;border-radius:8px;font-weight:800;font-size:12px;margin-right:8px;color:#fff}.m.g{background:#16a34a}.m.p{background:#7c5cff}.m.d{background:#e11d48}
