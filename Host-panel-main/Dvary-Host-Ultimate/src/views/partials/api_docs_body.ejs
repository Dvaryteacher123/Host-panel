.toc{display:flex;gap:8px;flex-wrap:wrap;margin:6px 0 10px}.toc a{padding:6px 12px;border-radius:99px;border:1px solid var(--line);font-size:13px;color:inherit}
.dc table{width:100%;border-collapse:collapse;font-size:13px;margin:8px 0}.dc th,.dc td{text-align:left;padding:7px 9px;border-bottom:1px solid var(--line);vertical-align:top}
