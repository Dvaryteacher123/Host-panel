<style>
:root{--bg:#05060f;--line:rgba(255,255,255,.09);--tx:#eef0ff;--mut:#8b93b8;--a:#7c5cff;--b:#2f8bff;--c:#22d3ee;--bad:#f43f5e;--g:linear-gradient(135deg,#7c5cff,#2f8bff)}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}html,body{margin:0;height:100%}
body{font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--tx);-webkit-font-smoothing:antialiased;overflow:hidden}
a{color:inherit;text-decoration:none}
.shell{position:fixed;inset:0;display:flex;flex-direction:column;background:radial-gradient(520px 380px at 8% 0,rgba(124,92,255,.24),transparent 60%),radial-gradient(560px 420px at 100% 100%,rgba(34,211,238,.13),transparent 60%),var(--bg)}
.hd{display:flex;align-items:center;gap:12px;padding:10px 14px;padding-top:calc(10px + env(safe-area-inset-top));background:rgba(8,10,28,.86);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border-bottom:1px solid var(--line);z-index:5;flex:none}
.back{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;font-size:26px;line-height:1;background:rgba(255,255,255,.06);border:1px solid var(--line);flex:none;cursor:pointer;color:var(--tx);font-family:inherit;padding:0 0 3px}
.back:hover{background:rgba(255,255,255,.12)}
.av{width:42px;height:42px;border-radius:50%;background:var(--g);display:grid;place-items:center;font-weight:800;font-size:18px;flex:none;position:relative;box-shadow:0 6px 18px rgba(124,92,255,.4)}
.av i{position:absolute;right:-1px;bottom:-1px;width:12px;height:12px;border-radius:50%;background:#22c55e;border:2px solid #080a1c;animation:pulse 2s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(34,197,94,.6)}70%{box-shadow:0 0 0 7px rgba(34,197,94,0)}100%{box-shadow:0 0 0 0 rgba(34,197,94,0)}}
.ht{min-width:0;flex:1}.ht b{display:block;font-size:15.5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ht small{color:var(--mut);font-size:12px}
.msgs{flex:1;overflow-y:auto;padding:14px 12px 8px;display:flex;flex-direction:column;background-image:radial-gradient(rgba(255,255,255,.04) 1px,transparent 1px);background-size:22px 22px;overscroll-behavior:contain}
.day{align-self:center;margin:14px 0 8px;font-size:11px;font-weight:700;color:var(--mut);background:rgba(255,255,255,.06);border:1px solid var(--line);padding:4px 12px;border-radius:99px;backdrop-filter:blur(8px)}
.row{display:flex;gap:8px;align-items:flex-end;margin-top:8px}.row.g{margin-top:2px}.row.me{flex-direction:row-reverse}
.mav{width:30px;height:30px;border-radius:50%;flex:none;display:grid;place-items:center;font-size:12px;font-weight:800;color:#fff}.mav.sp{visibility:hidden}
.bub{max-width:min(80%,540px);padding:8px 12px 6px;border-radius:18px;background:rgba(255,255,255,.08);border:1px solid var(--line);word-break:break-word;animation:pop .24s cubic-bezier(.2,.9,.3,1.2) both;cursor:pointer;box-shadow:0 4px 14px rgba(0,0,0,.25)}
.row.me .bub{background:var(--g);border-color:transparent;border-bottom-right-radius:5px;box-shadow:0 6px 18px rgba(124,92,255,.35)}
.row:not(.me) .bub{border-bottom-left-radius:5px}
@keyframes pop{from{opacity:0;transform:translateY(10px) scale(.96)}}
.nm{font-size:12px;font-weight:800;margin-bottom:2px;display:flex;gap:6px;align-items:center}
.bdg{font-size:9px;font-weight:800;letter-spacing:.06em;padding:2px 6px;border-radius:99px;background:linear-gradient(135deg,#f59e0b,#f43f5e);color:#fff}
.tx{font-size:14.5px;line-height:1.42;white-space:pre-wrap}
.tm{font-size:10.5px;opacity:.6;text-align:right;margin-top:2px}
.acts{display:none;gap:6px;margin-top:7px;justify-content:flex-end;flex-wrap:wrap}.bub.sel .acts{display:flex}
.acts button{border:0;border-radius:99px;padding:5px 11px;font:inherit;font-size:12px;font-weight:700;color:#fff;background:rgba(0,0,0,.35);cursor:pointer}.acts button:hover{background:var(--bad)}
.empty{margin:auto;text-align:center;color:var(--mut);font-size:14px;max-width:260px;line-height:1.5}.empty span{display:block;font-size:46px;margin-bottom:8px;animation:bob 3s ease-in-out infinite}
@keyframes bob{50%{transform:translateY(-8px)}}
.bar{display:flex;gap:10px;align-items:flex-end;padding:10px 12px calc(10px + env(safe-area-inset-bottom));background:rgba(8,10,28,.92);border-top:1px solid var(--line);flex:none}
.bar textarea{flex:1;resize:none;max-height:120px;border-radius:23px;border:1px solid var(--line);background:rgba(255,255,255,.07);color:var(--tx);padding:12px 17px;font:inherit;font-size:15px;outline:none;line-height:1.35;min-height:46px}
.bar textarea:focus{border-color:var(--a);background:rgba(255,255,255,.1)}
.snd{width:46px;height:46px;border-radius:50%;border:0;background:var(--g);color:#fff;font-size:19px;cursor:pointer;flex:none;box-shadow:0 8px 22px rgba(124,92,255,.45);transition:transform .15s}.snd:active{transform:scale(.88)}
@media(prefers-reduced-motion:reduce){*{animation:none!important}}
</style>
