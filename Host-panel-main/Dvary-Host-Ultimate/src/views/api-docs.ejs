<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#05060f">
<title>API Docs · <%= site.siteName %></title><style>
:root{--bg:#05060f;--line:rgba(255,255,255,.1);--tx:#eef0ff;--mut:#8b93b8}
*{box-sizing:border-box}html,body{margin:0}
body{font-family:Inter,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--tx);-webkit-font-smoothing:antialiased;line-height:1.6}
body:before{content:"";position:fixed;inset:0;z-index:-1;background:radial-gradient(600px 420px at 15% 0,rgba(124,92,255,.32),transparent 60%),radial-gradient(700px 500px at 95% 8%,rgba(47,139,255,.22),transparent 60%)}
a{color:#a9b4ff;text-decoration:none}.w{max-width:900px;margin:0 auto;padding:22px 16px 60px}
.top{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:18px}
.btn{display:inline-block;padding:10px 18px;border-radius:12px;background:linear-gradient(135deg,#7c5cff,#2f8bff);color:#fff;font-weight:700}
h1{font-size:30px;margin:0 0 6px;background:linear-gradient(90deg,#c4b5ff,#67e8f9,#f472b6);-webkit-background-clip:text;background-clip:text;color:transparent}
.mut,.hint{color:var(--mut)}.hint{font-size:13px}
.price{display:inline-block;padding:14px 18px;border-radius:16px;border:1px solid rgba(124,92,255,.5);background:rgba(124,92,255,.14);margin:10px 0 18px}
</style></head><body><div class="w">
<div class="top"><b style="font-size:18px"><%= site.siteName %></b><div><% if (currentUser) { %><a class="btn" href="/dashboard/api">🔑 My API</a><% } else { %><a href="/login" style="margin-right:14px">Login</a><a class="btn" href="/register">Get started</a><% } %></div></div>
<h1>DVARY API</h1>
<p class="mut" style="margin:0">Create and control Pterodactyl servers from your own app. Base URL <b><%= base %>/api/v1</b></p>
<div class="price"><b><%= plan.name %></b> · <%= priceText %> / <%= plan.durationDays %> days<% if (plan.active) { %> · <a href="/dashboard/api"><b>Get API Key →</b></a><% } %></div>
<%- include('partials/api_docs_body') %>
</div></body></html>
