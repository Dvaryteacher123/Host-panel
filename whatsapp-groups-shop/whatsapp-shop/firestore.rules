rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin whitelist. Nyaraka hizi huundwa MKONO kwenye Firebase Console pekee.
    // Doc ID = UID ya admin. Ndani ya doc weka: { email: "admin@mfano.com" }
    match /admins/{adminId} {
      allow read: if isSignedIn() && request.auth.uid == adminId;
      allow write: if false; // hakuna anayeandika kupitia app, console pekee
    }

    // Profile za watumiaji
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Products - hadharani kusoma, admin pekee kuandika
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders - backend (Admin SDK) ndiyo huandika (huipita rules hizi kabisa).
    // Client haiwezi kuunda/kubadilisha order moja kwa moja - inazuia
    // "USER KUJIPA PAYMENT SUCCESS".
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Support messages
    match /supportMessages/{messageId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}
