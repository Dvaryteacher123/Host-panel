# =========================================================
# NAKALA HII NI MFANO TU. USIWEKE SECRETS ZA KWELI HAPA.
# Kwenye Render, weka hizi kwenye: Dashboard -> Service yako -> Environment
# =========================================================

# Port ambayo Render itatumia (Render huweka yenyewe, lakini weka default)
PORT=10000

# HarakaPay
HARAKAPAY_API_KEY=weka_api_key_yako_ya_harakapay_hapa
HARAKAPAY_BASE_URL=https://harakapay.net

# URL kamili ya backend yako baada ya kudeploy Render
# Mfano: https://whatsapp-shop-backend.onrender.com
APP_BASE_URL=https://weka-render-domain-yako.onrender.com

# Firebase Admin SDK (Service Account) - tunatumia hizi 3 pekee, si faili la JSON zima
FIREBASE_PROJECT_ID=weka-project-id-yako
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@weka-project-id-yako.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nWEKA_PRIVATE_KEY_YAKO_HAPA\n-----END PRIVATE KEY-----\n"
